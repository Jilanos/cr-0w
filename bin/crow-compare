#!/usr/bin/env python3
"""crow-compare: build a page for visual decisions, options side by side, with a flip viewer.

Spec (JSON): {"title": str, "decisions": [{"id", "question", "context", "recommend",
  "rows": [row label, ...], "options": [{"label", "note", "images": [path per row or null]}]}]}
Image paths are absolute or relative to the spec file. The page is written next to the spec
(or --out) and links images relatively, so it works opened straight from disk.

Viewer: click an image to open it full screen. Left/Right flips between options at the same
row (same framing, so differences stand out), Up/Down changes row, Z toggles 100% zoom
(drag or scroll to pan), Esc closes.

usage: crow-compare SPEC.json [--out PAGE.html]
"""
import argparse, html, json, os
from pathlib import Path

CSS = """
:root{--bg:#f3f4f8;--surface:#fff;--fg:#1b1e2b;--muted:#5d6276;--line:#dcdfe9;--accent:#5b4bd6;--accent-soft:#ebe8fc}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#12131c;--surface:#1b1d2a;--fg:#e6e7f0;--muted:#9a9eb4;--line:#2d3044;--accent:#a597ff;--accent-soft:#2a2550;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#12131c;--surface:#1b1d2a;--fg:#e6e7f0;--muted:#9a9eb4;--line:#2d3044;--accent:#a597ff;--accent-soft:#2a2550;color-scheme:dark}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,sans-serif}
main{max-width:1600px;margin:0 auto;padding:24px 16px 64px}h1{margin:0 0 4px}.muted{color:var(--muted)}
section{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:6px 18px 18px;margin:20px 0}
.rec{display:inline-block;background:var(--accent-soft);color:var(--accent);border-radius:99px;padding:1px 10px;font-weight:600;font-size:.85rem}
.grid{display:grid;gap:10px;align-items:start;overflow-x:auto}
.head{font-weight:700}.head small{display:block;font-weight:400;color:var(--muted)}
.rowlabel{font-weight:600;color:var(--muted);writing-mode:vertical-rl;transform:rotate(180deg);text-align:center}
.cell img{width:100%;border:1px solid var(--line);border-radius:6px;cursor:zoom-in;display:block}
.cell.none{color:var(--muted);font-size:.85rem;padding:20px 0;text-align:center}
#v{position:fixed;inset:0;background:#000d;display:none;flex-direction:column;z-index:9}
#v.on{display:flex}#vbar{color:#fff;padding:8px 14px;display:flex;gap:16px;align-items:center;font-size:15px}
#vbar b{font-size:18px}#vbar .k{opacity:.7}#vbox{flex:1;overflow:auto;display:flex;align-items:center;justify-content:center;cursor:zoom-in}
#vbox img{max-width:100%;max-height:100%;object-fit:contain}#vbox.full{display:block;cursor:grab}#vbox.full img{max-width:none;max-height:none}
"""

JS = """
const D=window.DECISIONS;let cur=null;
const v=document.getElementById('v'),vi=document.getElementById('vi'),vt=document.getElementById('vt'),vbox=document.getElementById('vbox');
function show(){const d=D[cur.d],o=d.options[cur.o],src=o.images[cur.r];
 vi.src=src||'';vt.innerHTML='<b>'+o.label+'</b> &nbsp;·&nbsp; '+(d.rows[cur.r]||'')+' &nbsp;·&nbsp; option '+(cur.o+1)+'/'+d.options.length;}
function open_(d,o,r){cur={d,o,r};vbox.classList.remove('full');v.classList.add('on');show();}
function step(dO,dR){const d=D[cur.d];for(let i=0;i<d.options.length*d.rows.length;i++){
 cur.o=(cur.o+dO+d.options.length)%d.options.length;cur.r=(cur.r+dR+d.rows.length)%d.rows.length;
 if(d.options[cur.o].images[cur.r])break;}show();}
document.querySelectorAll('[data-d]').forEach(e=>e.onclick=()=>open_(+e.dataset.d,+e.dataset.o,+e.dataset.r));
vbox.onclick=e=>{if(!vbox.classList.contains('full'))vbox.classList.add('full');};
let drag=null;vbox.onmousedown=e=>{if(vbox.classList.contains('full'))drag={x:e.clientX,y:e.clientY,l:vbox.scrollLeft,t:vbox.scrollTop};};
window.onmousemove=e=>{if(drag){vbox.scrollLeft=drag.l-(e.clientX-drag.x);vbox.scrollTop=drag.t-(e.clientY-drag.y);}};window.onmouseup=()=>drag=null;
document.getElementById('vx').onclick=()=>v.classList.remove('on');
window.onkeydown=e=>{if(!v.classList.contains('on'))return;
 if(e.key==='Escape')v.classList.remove('on');else if(e.key==='ArrowRight')step(1,0);else if(e.key==='ArrowLeft')step(-1,0);
 else if(e.key==='ArrowDown')step(0,1);else if(e.key==='ArrowUp')step(0,-1);else if(e.key==='z'||e.key==='Z')vbox.classList.toggle('full');else return;e.preventDefault();};
"""


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("spec")
    ap.add_argument("--out")
    a = ap.parse_args()
    spec_path = Path(a.spec).resolve()
    spec = json.loads(spec_path.read_text())
    out = Path(a.out).resolve() if a.out else spec_path.with_suffix(".html")

    def rel(p):
        if not p:
            return None
        q = Path(p) if os.path.isabs(p) else spec_path.parent / p
        return os.path.relpath(q, out.parent) if q.exists() else None

    data, body = [], []
    for di, d in enumerate(spec["decisions"]):
        rows = d.get("rows") or [""]
        opts = [{"label": o["label"], "images": [rel(i) for i in (o.get("images") or [])] + [None] * len(rows)} for o in d["options"]]
        for o in opts:
            o["images"] = o["images"][:len(rows)]
        data.append({"rows": rows, "options": opts})
        n = len(opts)
        cols = f"28px repeat({n}, minmax(260px, 1fr))"
        cells = ['<div></div>'] + [
            f'<div class="head">{html.escape(o["label"])}<small>{html.escape(d["options"][i].get("note", ""))}</small></div>'
            for i, o in enumerate(opts)]
        for ri, r in enumerate(rows):
            cells.append(f'<div class="rowlabel">{html.escape(r)}</div>')
            for oi, o in enumerate(opts):
                src = o["images"][ri]
                cells.append(f'<div class="cell"><img loading="lazy" src="{html.escape(src)}" data-d="{di}" data-o="{oi}" data-r="{ri}" alt=""></div>'
                             if src else '<div class="cell none">no render</div>')
        rec = f'<p><span class="rec">Recommended: {html.escape(d["recommend"])}</span></p>' if d.get("recommend") else ""
        body.append(f'<section id="{html.escape(d.get("id", str(di)))}"><h2>{html.escape(d["question"])}</h2>'
                    f'<p class="muted">{html.escape(d.get("context", ""))}</p>{rec}'
                    f'<div class="grid" style="grid-template-columns:{cols}">{"".join(cells)}</div></section>')

    page = f"""<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{html.escape(spec.get("title", "Decisions"))}</title><style>{CSS}</style></head><body><main>
<h1>{html.escape(spec.get("title", "Decisions"))}</h1>
<p class="muted">Click an image to open it. ← → flip between options at the same spot · ↑ ↓ change scenario · Z zoom to 100% (drag to pan) · Esc close.</p>
{''.join(body)}</main>
<div id="v"><div id="vbar"><span id="vt"></span><span class="k">← → options · ↑ ↓ scenario · Z zoom · Esc</span><span style="flex:1"></span><button id="vx">Close</button></div>
<div id="vbox"><img id="vi" alt=""></div></div>
<script>window.DECISIONS={json.dumps(data)};{JS}</script></body></html>"""
    out.write_text(page)
    print(out)


if __name__ == "__main__":
    main()

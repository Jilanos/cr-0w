#!/usr/bin/env python3
"""Run a writer under a shared panel lock: crow-lock pending -- command args."""
import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
import crow_lib
from crow_panel.core import lock, shared_locks

if len(sys.argv) < 4 or sys.argv[2] != "--" or sys.argv[1] not in ("pending", "admission", "maintenance", "maj"):
    sys.exit("Usage: crow-lock pending|admission|maintenance|maj -- command [args]")
locks = shared_locks(crow_lib.data_home())
with lock(locks, sys.argv[1]):
    sys.exit(subprocess.run(sys.argv[3:]).returncode)

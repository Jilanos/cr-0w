#!/usr/bin/env python3
"""State helpers and night launcher for the `maj` routine (config: local/maj.json).

  crow-maj since                  watermark of the last finished run (ISO, UTC)
  crow-maj mark                   set the watermark to now (end of a successful run)
  crow-maj seen has <id>          exit 0 if the message id was already handled
  crow-maj seen add <id> [note]   record a handled message id
  crow-maj stage [YYYY-MM-DD]     create and print the attachment staging folder
  crow-maj board                  render the pending file and every a-ranger.md as HTML (bin/crow-board)
  crow-maj relay                  print today's attachment manifest path (the relay itself runs in `night`)
  crow-maj calendar import FILE   validate and publish a read-only calendar snapshot
  crow-maj calendar schema        print the calendar snapshot contract for /maj
  crow-maj night                  unattended run: headless /maj, then board, log in local/state/maj/night.log
"""
import datetime as dt
import json
import os
import subprocess
import sys
import time
from pathlib import Path

import crow_lib
import crow_limits

ENGINE = Path(__file__).resolve().parent.parent
HOME = Path(crow_lib.data_home())
CFG = json.loads((HOME / "local" / "maj.json").read_text(encoding="utf-8"))
STATE = HOME / "local" / "state" / "maj"
STATE.mkdir(parents=True, exist_ok=True)
WATERMARK, SEEN, LOG = STATE / "last-run", STATE / "seen.tsv", STATE / "night.log"


def now():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def log(msg):
    with LOG.open("a", encoding="utf-8") as fh:
        fh.write(f"{dt.datetime.now():%Y-%m-%d %H:%M:%S} {msg}\n")
    print(msg, flush=True)


def since():
    if WATERMARK.exists():
        return WATERMARK.read_text().strip()
    return (now() - dt.timedelta(hours=CFG.get("first_run_lookback_hours", 72))).isoformat()


def seen_ids():
    if not SEEN.exists():
        return set()
    return {line.split("\t", 1)[0] for line in SEEN.read_text(encoding="utf-8").splitlines() if line}


def board():
    cmd = [str(ENGINE / "bin" / "crow-board"), CFG["pending_md"]]
    for rm in CFG.get("board_root_map", []):
        cmd += ["--root-map", rm]
    res = subprocess.run(cmd, capture_output=True, text=True)
    # one page per attachment list, so files and source mails open in one click
    for md in sorted(Path(CFG["staging_dir"]).glob("*/a-ranger.md")):
        rm = CFG.get("staging_root_map")
        extra = ["--root-map", rm] if rm else []
        r = subprocess.run([str(ENGINE / "bin" / "crow-board"), str(md), "--refresh", "0", *extra], capture_output=True, text=True)
        res.stdout += r.stdout
    return res


def relay_start():
    """Start the hub download relay on today's manifest (Codex runs fetch signed URLs, the hub downloads)."""
    d = Path(CFG["pj_relay_dir"]) / dt.date.today().isoformat()
    d.mkdir(parents=True, exist_ok=True)
    m = d / "manifest.tsv"
    p = subprocess.Popen([str(ENGINE / "bin" / "crow-download-relay"), str(m)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return m, p


def calendar_contract():
    return {"synced_at": "ISO timestamp with offset", "time_zone": CFG.get("calendar_time_zone", "UTC"),
            "coverage": {"status": "complete or partial", "window_start": "ISO timestamp with offset", "window_end": "ISO timestamp with offset"},
            "events": [{"id": "occurrence id", "subject": "plain text", "start": "ISO timestamp with offset", "end": "ISO timestamp with offset",
                        "all_day": False, "cancelled": False, "location": "plain text", "web_link": "HTTPS Outlook link or null"}]}


def calendar_import(source):
    from crow_panel.calendar import publish
    from crow_panel.core import atomic, canonical
    target = Path(CFG.get("calendar_snapshot", STATE / "calendar.json"))
    try:
        result = publish(target, json.loads(Path(source).read_text()))
        print(json.dumps(result))
        return 0 if result["published"] else 1
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as exc:
        atomic(target.with_suffix(".attempt.json"), canonical({"checked_at": now().isoformat(), "status": "failed"}))
        print("Calendar snapshot rejected: " + type(exc).__name__, file=sys.stderr)
        return 2


def launch_night(cmd, env, limits):
    from crow_panel.core import lock, shared_locks
    account = CFG.get("account", "claude")
    # A panel precheck cannot reserve a slot for a child process. Recheck under
    # the shared lock and wait here if another launch took the account's slot.
    while True:
        with lock(shared_locks(HOME), "admission"):
            active = subprocess.run(["cdx", "runs", "--running", "--json"], capture_output=True, text=True, env=env)
            try:
                value = json.loads(active.stdout)
                runs = value["runs"]
                if active.returncode or value.get("ok") is False or not isinstance(runs, list):
                    raise ValueError("running runs unavailable")
                registry = crow_limits.read_registry(os.environ.get("CROW_PANEL_RUNS_REGISTRY", STATE.parent / "runs.jsonl"))
                usage = crow_limits.slots(runs, limits, registry)
                if crow_limits.available(account, usage, limits, "claude"):
                    return subprocess.run(cmd, capture_output=True, text=True, env=env)
            except (ValueError, KeyError):
                log("run admission unavailable; retrying")
        time.sleep(5)


def _night():
    from crow_panel.core import lock, shared_locks
    log("start")
    manifest, relay = relay_start()
    log(f"relay on {manifest}")
    import secrets
    calendar_incoming = STATE / ("calendar.incoming." + secrets.token_hex(8) + ".json")
    prompt = ("/maj mode=nuit\n\nCalendar snapshot for the panel: read Outlook calendar occurrences from today through the next 16 days, "
              "including recurring instances and all-day events. Use only calendar read tools. Never create, update, respond to or delete an event. "
              "Follow every page. Report partial coverage when access or pagination is incomplete. Do not invent events or infer an empty calendar from a failed read. "
              "Write this JSON contract to " + str(calendar_incoming) + " using actual ISO dates with offsets, IANA time zone and HTTPS links: " + json.dumps(calendar_contract()))
    account = CFG.get("account", "claude")
    limits = crow_limits.load(HOME)
    cmd = ["cdx", "run", account, "--cwd", str(HOME), "--model", CFG.get("model", "sonnet"),
           "--permission", "full", "--prompt", prompt, "--detach", "--max-parallel", str(limits["total"]), "--json"]
    env = dict(os.environ, HOME=crow_lib.real_home(), CROW_RETRO="1", CROW_MAJ_NIGHT="1")
    out = launch_night(cmd, env, limits)
    exit_code = out.returncode or 1
    try:
        res = json.loads(out.stdout)
        run_id = res.get("run_id")
        registry = os.environ.get("CROW_PANEL_RUNS_REGISTRY")
        if res.get("ok") and run_id and registry:
            record = {"run_id": run_id, "project": "crow", "label": "panel:routine.maj", "cwd": str(HOME),
                      "started_at": now().isoformat(), "prompt_file": None, "power": None, "source": "panel",
                      "operation_id": os.environ.get("CROW_PANEL_OPERATION_ID"), "topic_id": None,
                      "account": CFG.get("account", "claude"), "model": CFG.get("model", "sonnet"), "kind": "agent",
                      "parent_script": os.environ.get("CROW_PANEL_PARENT_RUN")}
            with lock(shared_locks(HOME), "registry"):
                path = Path(registry)
                path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                with path.open("a") as stream:
                    stream.write(json.dumps(record) + "\n")
                    stream.flush()
                    os.fsync(stream.fileno())
                path.chmod(0o600)
        offset = 0
        while res.get("ok") and run_id:
            status = subprocess.run(["cdx", "run-status", run_id, "--json"], capture_output=True, text=True, env=env)
            try:
                row = json.loads(status.stdout).get("run") or {}
            except ValueError:
                log("run status unavailable; retrying")
                time.sleep(5)
                continue
            artifact = (row.get("artifacts") or row).get("stdout_path")
            if artifact and Path(artifact).is_file():
                with Path(artifact).open("rb") as stream:
                    stream.seek(offset)
                    chunk = stream.read()
                end = chunk.rfind(b"\n") + 1
                if end:
                    sys.stdout.write(chunk[:end].decode("utf-8", "replace"))
                    sys.stdout.flush()
                    offset += end
            if row.get("ended_at"):
                res = {**res, **row}
                exit_code = row.get("exit_code") if row.get("exit_code") is not None else 1
                break
            time.sleep(5)
        log(f"run ok={res.get('ok')} exit={res.get('exit_code')} run_id={res.get('run_id')} stdout={res.get('stdout_path')}")
    except json.JSONDecodeError:
        log("run failed: " + (out.stderr or out.stdout)[-400:].replace("\n", " "))
    Path(str(manifest) + ".done").touch()
    try:
        relay.wait(timeout=120)
    except subprocess.TimeoutExpired:
        relay.kill()
    if exit_code == 0:
        log("calendar import exit=" + str(calendar_import(calendar_incoming)))
    b = board()
    log(f"board {'ok' if b.returncode == 0 else 'failed: ' + b.stderr[-200:]}")
    log("end")
    panel_config = HOME / "local/panel.yaml"
    if panel_config.is_file():
        sync = subprocess.run([str(ENGINE / "bin/crow-panel"), "sync", "--config", str(panel_config)],
                              capture_output=True, text=True, env=env)
        log(f"panel sync queued={sync.returncode == 0}")
    return exit_code


def night():
    from crow_panel.core import lock, shared_locks
    locks = shared_locks(HOME)
    with lock(locks, "maj", False), lock(locks, "pending"):
        return _night()


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv[0]
    if cmd == "since":
        print(since())
    elif cmd == "mark":
        WATERMARK.write_text(now().isoformat() + "\n")
        print(WATERMARK.read_text().strip())
    elif cmd == "seen" and len(argv) >= 3 and argv[1] == "has":
        ids = seen_ids()
        return 0 if argv[2] in ids or any(len(i) >= 10 and argv[2].endswith(i) for i in ids) else 1
    elif cmd == "seen" and len(argv) >= 3 and argv[1] == "add":
        if argv[2] not in seen_ids():
            with SEEN.open("a", encoding="utf-8") as fh:
                fh.write(f"{argv[2]}\t{now().isoformat()}\t{' '.join(argv[3:])}\n")
    elif cmd == "stage":
        day = argv[1] if len(argv) > 1 else dt.date.today().isoformat()
        p = Path(CFG["staging_dir"]) / day
        p.mkdir(parents=True, exist_ok=True)
        print(p)
    elif cmd == "board":
        b = board()
        sys.stdout.write(b.stdout)
        sys.stderr.write(b.stderr)
        return b.returncode
    elif cmd == "relay":
        d = Path(CFG["pj_relay_dir"]) / dt.date.today().isoformat()
        d.mkdir(parents=True, exist_ok=True)
        print(d / "manifest.tsv")
    elif cmd == "night":
        return night()
    elif cmd == "calendar" and len(argv) == 2 and argv[1] == "schema":
        print(json.dumps(calendar_contract(), indent=2))
    elif cmd == "calendar" and len(argv) == 3 and argv[1] == "import":
        return calendar_import(argv[2])
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

.cell img{width:100%;border:1px solid var(--line);border-radius:6px;cursor:zoom-in;display:block}.cell.none{color:var(--muted);font-size:.85rem;text-align:center;padding:24px 4px;border:1px dashed var(--line);border-radius:6px}
ul.plain{margin:2px 0;padding-left:20px}ul.plain li{margin:3px 0}
.shots{display:flex;flex-wrap:wrap;gap:8px}.shots img{width:170px;height:105px;object-fit:cover;object-position:top left;border:1px solid var(--line);border-radius:6px;cursor:zoom-in}
pre{overflow-x:auto;background:var(--bg);padding:8px;border-radius:6px}code{font-family:var(--mono);font-size:.86em}

#v{position:fixed;inset:0;background:#000e;display:none;flex-direction:column;z-index:9}#v.on{display:flex}
#vbar{color:#fff;padding:8px 14px;display:flex;gap:16px;align-items:center}#vbar b{font-size:17px}
#vbox{flex:1;overflow:auto;display:flex;align-items:center;justify-content:center;cursor:zoom-in}
#vbox img{max-width:100%;max-height:100%;object-fit:contain}#vbox.full{display:block;cursor:grab}#vbox.full img{max-width:none;max-height:none}
"""

JS = """
let G=[],r=0,c=0;const v=document.getElementById('v'),vi=document.getElementById('vi'),vt=document.getElementById('vt'),vb=document.getElementById('vbox');
function show(){const x=G[r][c];vi.src=x.src;vt.innerHTML='<b>'+x.label+'</b>'+(G.length>1?' &nbsp;·&nbsp; '+x.row:'')+' &nbsp;·&nbsp; '+(c+1)+'/'+G[r].length;}
function step(dc,dr){for(let k=0;k<50;k++){r=(r+dr+G.length)%G.length;c=(c+dc+G[r].length)%G[r].length;if(G[r][c])break;}show();}
function openSet(g,row,col){G=g;r=row;c=col;vb.classList.remove('full');v.classList.add('on');show();}
document.querySelectorAll('.opts').forEach(box=>{const imgs=[...box.querySelectorAll('img[data-r]')];if(!imgs.length)return;
 const rows=Math.max(...imgs.map(i=>+i.dataset.r))+1,cols=Math.max(...imgs.map(i=>+i.dataset.c))+1;
 const g=[...Array(rows)].map(()=>Array(cols).fill(null));imgs.forEach(i=>g[+i.dataset.r][+i.dataset.c]={src:i.getAttribute('src'),label:i.dataset.l,row:i.dataset.row});
 imgs.forEach(i=>i.onclick=()=>openSet(g,+i.dataset.r,+i.dataset.c));});
document.querySelectorAll('.shots').forEach(box=>{const imgs=[...box.querySelectorAll('img')];const g=[imgs.map(i=>({src:i.getAttribute('src'),label:i.title,row:''}))];
 imgs.forEach((i,k)=>i.onclick=()=>openSet(g,0,k));});
vb.onclick=()=>{if(!vb.classList.contains('full'))vb.classList.add('full');};
let drag=null;vb.onmousedown=e=>{if(vb.classList.contains('full'))drag={x:e.clientX,y:e.clientY,l:vb.scrollLeft,t:vb.scrollTop};};
window.onmousemove=e=>{if(drag){vb.scrollLeft=drag.l-(e.clientX-drag.x);vb.scrollTop=drag.t-(e.clientY-drag.y);}};window.onmouseup=()=>drag=null;
document.getElementById('vx').onclick=()=>v.classList.remove('on');
window.onkeydown=e=>{if(!v.classList.contains('on'))return;if(e.key==='Escape')v.classList.remove('on');
 else if(e.key==='ArrowRight')step(1,0);else if(e.key==='ArrowLeft')step(-1,0);else if(e.key==='ArrowDown')step(0,1);else if(e.key==='ArrowUp')step(0,-1);
 else if(e.key==='z'||e.key==='Z')vb.classList.toggle('full');else return;e.preventDefault();};
"""


def md(text):
    return markdown.markdown(text or "", extensions=["tables", "fenced_code", "sane_lists"])


def inline(text):
    return re.sub(r"^<p>|</p>$", "", md(text).strip())


def esc(s):
    return html.escape(str(s or ""))


def ts(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00")) if s else None


def sections(text):
    out, cur = {}, None
    for line in text.splitlines():
        m = HEAD.match(line)
        if m:
            cur = next(s for s in SECTIONS if s.lower() == m.group(1).lower())
            out[cur] = (m.group(2) + "\n") if m.group(2).strip() else ""
        elif cur:
            out[cur] += line + "\n"
    return out


def shots_for(text, night):
    found = []
    for p in re.findall(r"(/[^\s`'\")]*?/shots/[^\s`'\")]+)", text):
        base = Path(p.rstrip(".,:;").split("*")[0])
        if base.suffix == ".png" and base.exists():
            found.append(base)
        elif base.is_dir():
            found += sorted(base.rglob("*.png"))
    seen, res = set(), []
    for c in found:
        if c not in seen and "/frames" not in str(c):
            seen.add(c); res.append(c)
    return [os.path.relpath(c, night) for c in res[:12]]


def sh_json(cmd, timeout=180):
    try:
        env = dict(os.environ, CROW_HOME=str(CROW))  # worktree copies read the main checkout's local/
        return json.loads(subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def fmt_dur(sec):
    m = int(sec // 60)
    return f"{m // 60}h{m % 60:02d}" if m >= 60 else f"{m} min"


def fmt_tok(n):
    return f"{n / 1e6:.1f}M" if n >= 1e6 else f"{n / 1e3:.0f}k"


def sample_at(samples, account, when):
    best = None
    for s in samples:
        if s["a"] == account and (best is None or abs(s["t"] - when) < abs(best["t"] - when)):
            best = s
    return best


def timeline_svg(lanes, t0, t1, color, width=1100, lane_h=26):
    """lanes: [(label, [(start, end, color_key, text)])]"""
    span = max((t1 - t0).total_seconds(), 1)
    left, h = 90, lane_h * len(lanes) + 22
    sx = lambda t: left + (width - left - 10) * max(0, min(1, (t - t0).total_seconds() / span))
    out = [f'<svg class="tl" viewBox="0 0 {width} {h}" role="img">']
    hour = t0.replace(minute=0, second=0, microsecond=0)
    while hour <= t1:
        if hour >= t0:
            x = sx(hour)
            out.append(f'<line x1="{x:.0f}" x2="{x:.0f}" y1="0" y2="{h - 16}" stroke="currentColor" opacity=".12"/>'
                       f'<text x="{x:.0f}" y="{h - 4}" text-anchor="middle">{hour.astimezone().strftime("%H:%M")}</text>')
        hour += dt.timedelta(hours=1)
    for i, (label, bars) in enumerate(lanes):
        y = i * lane_h + 2
        out.append(f'<text x="0" y="{y + 16}">{esc(label)}</text>')
        for s, e, key, text in bars:
            x0, x1 = sx(s), max(sx(e), sx(s) + 3)
            out.append(f'<rect class="bar" x="{x0:.1f}" y="{y}" width="{x1 - x0:.1f}" height="{lane_h - 6}" fill="{color(key)}"><title>{esc(text)}</title></rect>')
            if x1 - x0 > 60:
                out.append(f'<text class="lab" x="{x0 + 5:.0f}" y="{y + 15}">{esc(text.split(" · ")[0][: int((x1 - x0) / 6.5)])}</text>')
    out.append("</svg>")
    return "".join(out)


def decision_html(n, d, night):
    opts, rows = d.get("options", []), d.get("rows") or []
    rec = (d.get("recommend") or "").lower()
    is_rec = [bool(rec) and (o["label"].lower().startswith(rec) or rec in o["label"].lower()) for o in opts]

    def head(i, o):
        badge = "<span class=r>recommended</span>" if is_rec[i] else ""
        note = f"<small>{inline(o['note'])}</small>" if o.get("note") else ""
        return f'<div class="opt{" rec" if is_rec[i] else ""}">{badge}<b>{inline(o["label"])}</b>{note}</div>'

    if rows:
        cells = ['<div></div>'] + [head(i, o) for i, o in enumerate(opts)]
        for ri, row in enumerate(rows):
            cells.append(f'<div class="rowlabel">{esc(row)}</div>')
            for ci, o in enumerate(opts):
                imgs = o.get("images") or []
                src = imgs[ri] if ri < len(imgs) else None
                cells.append(f'<div class="cell"><img loading="lazy" src="{esc(src)}" data-r="{ri}" data-c="{ci}" data-l="{esc(o["label"])}" data-row="{esc(row)}" alt=""></div>'
                             if src and (night / src).exists() else '<div class="cell none">not rendered</div>')
        grid = f'<div class="opts" style="grid-template-columns:22px repeat({len(opts)},minmax(220px,1fr))">{"".join(cells)}</div>'
    else:
        grid = f'<div class="opts" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">{"".join(head(i, o) for i, o in enumerate(opts))}</div>'
    return f'<div class="dec" id="d{n}"><h4><span class="n">{n}</span>{inline(d["q"])}</h4><p class="muted">{inline(d.get("context"))}</p>{grid}</div>'


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--night", default=str(CROW / "local/state/night"))
    ap.add_argument("--date", default=dt.date.today().isoformat())
    a = ap.parse_args()
    night = Path(a.night)
    S = json.loads((night / f"summary-{a.date}.json").read_text())
    reports = {p.stem: p.read_text() for p in (night / "reports").glob("*.md") if "." not in p.stem}
    log = (night / "log.md").read_text() if (night / "log.md").exists() else ""
    t0, t1 = ts(S["start"]), ts(S["end"])

    cdx = {r["run_id"][:8]: r for r in (sh_json(["cdx", "runs", "--since", "3d", "--limit", "300", "--json"]) or {}).get("runs", [])}
    usage = sh_json([str(CROW / "bin/crow-usage"), "--json"], timeout=300) or {}  # main checkout copy: same data, its own environment
    cost_by_session = {s["id"]: s.get("cost_usd") or 0 for s in usage.get("sessions", [])}
    samples = []
    lp = CROW / "local/state/limit-samples.jsonl"
    if lp.exists():
        for line in lp.read_text().splitlines():
            try:
                samples.append(json.loads(line))
            except ValueError:
                pass

    def run_info(rid):
        r = cdx.get(rid, {})
        sid = ""
        out = Path((r.get("artifacts") or {}).get("stdout_path") or "/nonexistent")
        if out.exists():  # the run's claude result carries the session id that crow-usage prices
            try:
                sid = json.loads(out.read_text()).get("session_id", "")
            except ValueError:
                pass
        s, e = ts(r.get("started_at")), ts(r.get("ended_at"))
        return {"start": s, "end": e, "account": r.get("session", "?"), "model": r.get("model") or "profile default",
                "tokens": (r.get("usage") or {}).get("total_tokens") or 0, "cost": cost_by_session.get(sid, 0.0),
                "dur": (e - s).total_seconds() if s and e else 0}

    projects = S.get("projects", [])
    pcolor = {p["name"]: PALETTE[i % len(PALETTE)] for i, p in enumerate(projects)}
    allruns = []
    for p in projects:
        ids = []
        for pt in p.get("points", []):
            ids += [x for x in pt.get("runs", []) if x not in ids]
        p["_runs"] = [(rid, run_info(rid)) for rid in ids]
        allruns += [(p["name"], rid, ri) for rid, ri in p["_runs"]]

    tot_cost = sum(ri["cost"] for _, _, ri in allruns)
    tot_tok = sum(ri["tokens"] for _, _, ri in allruns)
    orch = cost_by_session.get(S.get("orchestrator_session", ""), 0)
    n_dec = sum(len(p.get("decisions", [])) for p in projects)
    n_todo = sum(len(p.get("todo", [])) for p in projects)
    accounts = sorted({ri["account"] for _, _, ri in allruns})
    lanes = [(acc, [(ri["start"], ri["end"], proj, f"{proj} · {rid} · {fmt_dur(ri['dur'])}")
                    for proj, rid, ri in allruns if ri["account"] == acc and ri["start"]]) for acc in accounts]
    usage_lines = []
    for acc in accounts:  # summary "usage" (recorded by the orchestrator) beats samples, which only keep a few hours
        u = (S.get("usage") or {}).get(acc)
        if u:
            usage_lines.append(f"<b>{esc(acc)}</b> week {u['week'][0]}% → {u['week'][1]}% left")
            continue
        b, e = sample_at(samples, acc, t0.timestamp()), sample_at(samples, acc, t1.timestamp())
        if b and e and abs(b["t"] - t0.timestamp()) < 3600:
            usage_lines.append(f"<b>{esc(acc)}</b> week {b['wk']}% → {e['wk']}% left")

    tldr = "".join(f'<a href="#p-{esc(p["name"])}" style="color:{pcolor[p["name"]]}">{esc(p["name"])}</a><span>{inline(p.get("tldr"))}</span>' for p in projects)
    legend = "".join(f'<span><i style="background:{pcolor[p["name"]]}"></i>{esc(p["name"])}</span>' for p in projects)
    top = (f'<div class="card"><div class="ph"><h2>TL;DR</h2><span class="muted">{t0.astimezone():%a %d %b %H:%M} → {t1.astimezone():%H:%M}</span></div>'
           f'<div class="tldr">{tldr}</div>'
           f'<div class="kpis"><span class="kpi"><b>{len(allruns)}</b>runs</span><span class="kpi"><b>${tot_cost:.0f}</b>runs cost</span>'
           f'<span class="kpi"><b>${orch:.0f}</b>orchestrator session</span><span class="kpi"><b>{fmt_tok(tot_tok)}</b>tokens (incl. cache)</span>'
           f'<span class="kpi"><b>{n_dec}</b>decisions</span><span class="kpi"><b>{n_todo}</b>checks by hand</span></div>'
           f'{timeline_svg(lanes, t0, t1, lambda k: pcolor.get(k, "#888"))}<div class="legend">{legend}</div>'
           f'<div class="usage">{" · ".join(usage_lines)}</div></div>')

    body, dn = [], 0
    for p in projects:
        runs = p["_runs"]
        pc = sum(ri["cost"] for _, ri in runs)
        active = sum(ri["dur"] for _, ri in runs)
        ptok = sum(ri["tokens"] for _, ri in runs)
        accs = sorted({ri["account"] for _, ri in runs})
        plane = [(rid, [(ri["start"], ri["end"], p["name"], f"{rid} · {ri['account']} · {fmt_dur(ri['dur'])} · ${ri['cost']:.2f}")]) for rid, ri in runs if ri["start"]]
        pts = []
        for pt in p.get("points", []):
            rb = []
            for rid in pt.get("runs", []):
                ri = dict(runs)[rid]
                text = reports.get(rid, "")
                sec = sections(text)
                shots = shots_for(text, night)
                inner = (md(sec.get("Card")) if sec.get("Card") else "") + (
                    '<div class="shots">' + "".join(f'<img loading="lazy" src="{esc(s)}" title="{esc(Path(s).name)}" alt="">' for s in shots) + "</div>" if shots else "") + (
                    f'<details class="full"><summary>Full report</summary>{md(text)}</details>' if text else "")
                when = ri["start"].astimezone().strftime("%H:%M") if ri["start"] else "?"
                rb.append(f'<div class="rbody"><div class="rmeta">{rid} · {when} · {esc(ri["account"])} · {esc(ri["model"])} · {fmt_dur(ri["dur"])} · ${ri["cost"]:.2f} · {fmt_tok(ri["tokens"])} tokens</div>{inner}</div>')
            pts.append(f'<div class="pt"><h4>{inline(pt["title"])}<span class="where">{esc(pt.get("where"))}</span></h4><p>{inline(pt["text"])}</p>'
                       f'<details class="runs"><summary>Details: {len(rb)} run{"s" * (len(rb) != 1)}, before/after, screenshots, report</summary>{"".join(rb)}</details></div>')
        decs = []
        for d in p.get("decisions", []):
            dn += 1
            decs.append(decision_html(dn, d, night))
        body.append(
            f'<section class="card" id="p-{esc(p["name"])}"><div class="ph"><h2><span class="dot" style="background:{pcolor[p["name"]]}"></span>{esc(p["name"])}</h2>'
            f'<span class="tl-txt">{len(runs)} run{"s" * (len(runs) != 1)} · {fmt_dur(active)} · ${pc:.2f} · {fmt_tok(ptok)} tokens · {esc(", ".join(accs))}</span></div>'
            f'<p class="muted" style="margin:4px 0 6px">{inline(p.get("progress"))}</p>'
            f'{timeline_svg(plane, t0, t1, lambda k: pcolor.get(k, "#888"), lane_h=22)}'
            f'<h3>What was done</h3>{"".join(pts)}'
            + (f'<h3>Decisions ({len(decs)})</h3>{"".join(decs)}' if decs else "")
            + (f'<h3>By hand</h3><ul class="plain">{"".join(f"<li>{inline(t)}</li>" for t in p["todo"])}</ul>' if p.get("todo") else "")
            + (f'<h3>Already decided</h3><ul class="plain muted">{"".join(f"<li>{inline(t)}</li>" for t in p["decided"])}</ul>' if p.get("decided") else "")
            + "</section>")

    notes = "".join(f"<li>{inline(n)}</li>" for n in S.get("notes", []))
    entries = [l[2:] for l in log.splitlines() if l.startswith("- ")]
    page = f"""<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Night Report {esc(a.date)}</title><style>{CSS}</style></head><body><main>
<p class="muted" style="margin:0 0 4px">rebuilt {dt.datetime.now():%H:%M} · click an image: ← → flip, ↑ ↓ scenario, Z zoom, Esc</p>
<h1 style="margin-bottom:14px">{esc(S.get("title"))}</h1>
{top}{"".join(body)}
{f'<div class="card"><h3 style="margin-top:0">Notes</h3><ul class="plain">{notes}</ul></div>' if notes else ""}
<details class="card"><summary><b>Night log</b> <span class="muted">{len(entries)} entries</span></summary><ul class="log">{"".join(f"<li>{esc(e)}</li>" for e in entries)}</ul></details>
</main><div id="v"><div id="vbar"><span id="vt"></span><span style="opacity:.7">← → flip · ↑ ↓ scenario · Z zoom · Esc</span><span style="flex:1"></span><button id="vx">Close</button></div>
<div id="vbox"><img id="vi" alt=""></div></div><script>{JS}</script></body></html>"""
    out = night / f"report-{a.date}.html"
    out.write_text(page)
    print(out)


if __name__ == "__main__":
    main()

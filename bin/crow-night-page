#!/usr/bin/env python3
"""crow-night-page: rebuild the overnight morning page from the night state on disk.

Layout (single column):
  TL;DR      one line per project, then night KPIs: runs, cost, tokens, decisions, and a
             timeline of every run per account with usage before -> after per account
  Project    per project: KPI line (runs, active time, cost, tokens, roadmap progress), a mini
             timeline of its runs, what was done point by point (each point unfolds into its
             runs: account, model, duration, cost, before/after, screenshots, full report), the
             project's decisions (options side by side, renders when visual), checks by hand,
             and what is already decided
  Notes, night log (folded)

Inputs: <night>/summary-<date>.json (start, end, orchestrator_session, notes[], projects[]:
name, tldr, progress, points[{title, text, where, runs[]}], decisions[{q, context, recommend,
rows[], options[{label, note, images[]}]}], todo[], decided[]), <night>/reports/<run8>.md,
<night>/log.md, `cdx runs --json` (times, account, model, tokens), `crow-usage --json`
(cost per session) and <state>/limit-samples.jsonl (usage before/after).
Viewer: click an image; Left/Right flip options or screenshots at the same framing, Up/Down
change scenario, Z zooms to 100%, Esc closes.

usage: crow-night-page [--night DIR] [--date YYYY-MM-DD]
"""
import argparse, datetime as dt, html, json, os, re, subprocess
from pathlib import Path

import markdown

# local/ lives only in the main checkout, so resolve it even when run from a worktree
CROW = Path(subprocess.check_output(["git", "-C", str(Path(__file__).resolve().parent), "rev-parse",
                                     "--path-format=absolute", "--git-common-dir"], text=True).strip()).parent
BIN = Path(__file__).resolve().parent
SECTIONS = ("Shipped", "Paused for the owner", "Next eligible", "Problems", "Card")
HEAD = re.compile(r"^\s*(?:#+\s*)?(?:\*\*)?(" + "|".join(SECTIONS) + r")(?:\*\*)?\s*:?\s*(?:\*\*)?\s*(.*)$", re.I)
PALETTE = ["#5b4bd6", "#1f8a5b", "#c2477a", "#2f7fd0", "#b26a00", "#7a8a1f", "#8b4bb8", "#2a9d8f"]

CSS = """

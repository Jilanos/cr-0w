.pt p{margin:4px 0}.where{font:600 .76rem var(--mono);color:var(--accent);background:var(--accent-soft);padding:1px 8px;border-radius:99px;margin-left:6px;white-space:nowrap}
details.runs>summary{cursor:pointer;color:var(--muted);font-size:.88rem}.rmeta{font:.8rem var(--mono);color:var(--muted)}

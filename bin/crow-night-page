#!/usr/bin/env python3
"""crow-night-page: rebuild the overnight morning page from the night state on disk.

Layout (single column, read top to bottom):
  header       night window, counters, accounts line
  TL;DR        one line per area
  Decisions    numbered cards; each shows its options side by side (columns), with screenshots
               per scenario (rows) when the choice is visual, and the recommendation marked
  By hand      checks only the owner can do, grouped by project
  Decided      what is already settled
  Projects     one block per project: verdict line, then one row per run (status, what, result,
               where it landed). A row unfolds into its before/after, screenshots and full report.
  Night log    folded

Inputs: <night>/summary-<date>.json, <night>/reports/<run8>.md, <night>/log.md, <state>/runs.jsonl.
summary keys: title, window, accounts, tldr[], decisions[{project, q, context, recommend, rows[],
options[{label, note, images[] per row}]}], todo[{project, items[]}], decided[], notes[],
projects[{name, verdict, runs[{id, what, result, where}]}]. The orchestrator adds a run line after
each finished run; runs with a report but no line still show (label + Card "after").
Viewer: click any image; Left/Right flip between options (decisions) or screenshots (runs) at the
same framing, Up/Down change scenario, Z zooms to 100%, Esc closes.

usage: crow-night-page [--night DIR] [--date YYYY-MM-DD]
"""
import argparse, datetime as dt, html, json, os, re, subprocess
from pathlib import Path

import markdown

# local/ lives only in the main checkout, so resolve it even when run from a worktree
CROW = Path(subprocess.check_output(["git", "-C", str(Path(__file__).resolve().parent), "rev-parse",
                                     "--path-format=absolute", "--git-common-dir"], text=True).strip()).parent
SECTIONS = ("Shipped", "Paused for the owner", "Next eligible", "Problems", "Card")
HEAD = re.compile(r"^\s*(?:#+\s*)?(?:\*\*)?(" + "|".join(SECTIONS) + r")(?:\*\*)?\s*:?\s*(?:\*\*)?\s*(.*)$", re.I)

CSS = """
:root{--bg:#f4f5f9;--surface:#fff;--fg:#1b1e2b;--muted:#5d6276;--line:#e1e4ec;--accent:#5b4bd6;--accent-soft:#ebe8fc;
--ok:#1f8a5b;--ok-soft:#e1f3ea;--wait:#9a5c00;--wait-soft:#fbefdc;--mono:ui-monospace,"JetBrains Mono",monospace}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#12131c;--surface:#1a1c28;--fg:#e6e7f0;--muted:#9a9eb4;--line:#2b2e41;
--accent:#a597ff;--accent-soft:#29244d;--ok:#5fd39a;--ok-soft:#173326;--wait:#f0b45a;--wait-soft:#38290f;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#12131c;--surface:#1a1c28;--fg:#e6e7f0;--muted:#9a9eb4;--line:#2b2e41;--accent:#a597ff;--accent-soft:#29244d;
--ok:#5fd39a;--ok-soft:#173326;--wait:#f0b45a;--wait-soft:#38290f;color-scheme:dark}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:15.5px/1.55 system-ui,"Segoe UI",sans-serif}
main{max-width:1180px;margin:0 auto;padding:28px 16px 80px}a{color:var(--accent)}
h1{font-size:1.7rem;margin:0}h2{font-size:1.15rem;margin:26px 0 10px}h3{font-size:1rem;margin:0}.muted{color:var(--muted)}
.top{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;margin-bottom:12px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}.chip{background:var(--surface);border:1px solid var(--line);border-radius:99px;padding:3px 12px;font-size:.9rem}
.box{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 18px;margin:0 0 12px}
.box ul{margin:4px 0 0;padding-left:20px}.box li{margin:3px 0}
nav{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.92rem;margin:0 0 6px}
.dec{background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--wait);border-radius:12px;padding:12px 18px;margin:0 0 12px}
.dec .tag{font:600 .75rem var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.dec .n{display:inline-block;min-width:26px;text-align:center;background:var(--wait-soft);color:var(--wait);border-radius:6px;font-weight:700;margin-right:8px}
.dec p{margin:4px 0 10px}.opts{display:grid;gap:10px;align-items:stretch;overflow-x:auto}
.opt{border:1px solid var(--line);border-radius:10px;padding:8px 10px;background:var(--bg)}.opt.rec{border:2px solid var(--accent);background:var(--accent-soft)}
.opt b{display:block}.opt small{color:var(--muted)}.opt .r{font:700 .7rem var(--mono);color:var(--accent);text-transform:uppercase}
.rowlabel{font-size:.8rem;font-weight:600;color:var(--muted);align-self:center;writing-mode:vertical-rl;transform:rotate(180deg)}
.cell img{width:100%;border:1px solid var(--line);border-radius:6px;cursor:zoom-in;display:block}.cell.none{color:var(--muted);font-size:.85rem;text-align:center;padding:24px 4px;border:1px dashed var(--line);border-radius:6px}
.proj{background:var(--surface);border:1px solid var(--line);border-radius:12px;margin:0 0 12px;overflow:hidden}
.ph{padding:10px 18px;border-bottom:1px solid var(--line)}.ph .v{margin:2px 0 0}.ph .meta{float:right;color:var(--muted);font-size:.85rem}
details.run{border-top:1px solid var(--line)}details.run:first-of-type{border-top:0}
details.run>summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:20px minmax(130px,200px) 1fr auto;gap:10px;padding:8px 18px;align-items:baseline}
details.run>summary::-webkit-details-marker{display:none}details.run>summary:hover,details.run[open]>summary{background:var(--bg)}
.st{font-weight:700;color:var(--ok)}.what{font-weight:600}.where{font:600 .76rem var(--mono);color:var(--accent);background:var(--accent-soft);padding:1px 8px;border-radius:99px;white-space:nowrap}
.body{padding:4px 18px 16px 48px}.body h4{margin:12px 0 4px;font-size:.8rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.shots{display:flex;flex-wrap:wrap;gap:8px}.shots img{width:180px;height:110px;object-fit:cover;object-position:top left;border:1px solid var(--line);border-radius:6px;cursor:zoom-in}
pre{overflow-x:auto;background:var(--bg);padding:8px;border-radius:6px}code{font-family:var(--mono);font-size:.86em}
table{border-collapse:collapse;display:block;overflow-x:auto}td,th{border:1px solid var(--line);padding:3px 8px}
details.full>summary{cursor:pointer;color:var(--muted);margin-top:10px}.log{font-size:.9rem;color:var(--muted)}
@media (max-width:640px){details.run>summary{grid-template-columns:18px 1fr}.res,.where{grid-column:2}.body{padding-left:18px}}
#v{position:fixed;inset:0;background:#000e;display:none;flex-direction:column;z-index:9}#v.on{display:flex}
#vbar{color:#fff;padding:8px 14px;display:flex;gap:16px;align-items:center}#vbar b{font-size:17px}
#vbox{flex:1;overflow:auto;display:flex;align-items:center;justify-content:center;cursor:zoom-in}
#vbox img{max-width:100%;max-height:100%;object-fit:contain}#vbox.full{display:block;cursor:grab}#vbox.full img{max-width:none;max-height:none}
"""

JS = """
// a set is a grid: G[row][col] = {src,label}; flipping Left/Right moves along a row
let G=[],r=0,c=0;const v=document.getElementById('v'),vi=document.getElementById('vi'),vt=document.getElementById('vt'),vb=document.getElementById('vbox');
function show(){const x=G[r][c];vi.src=x.src;vt.innerHTML='<b>'+x.label+'</b>'+(G.length>1?' &nbsp;·&nbsp; '+x.row:'')+' &nbsp;·&nbsp; '+(c+1)+'/'+G[r].length;}
function step(dc,dr){for(let k=0;k<50;k++){r=(r+dr+G.length)%G.length;c=(c+dc+G[r].length)%G[r].length;if(G[r][c])break;}show();}
function openSet(g,row,col){G=g;r=row;c=col;vb.classList.remove('full');v.classList.add('on');show();}
document.querySelectorAll('.opts').forEach(box=>{const imgs=[...box.querySelectorAll('img[data-r]')];if(!imgs.length)return;
 const rows=Math.max(...imgs.map(i=>+i.dataset.r))+1,cols=Math.max(...imgs.map(i=>+i.dataset.c))+1;
 const g=[...Array(rows)].map(()=>Array(cols).fill(null));imgs.forEach(i=>g[+i.dataset.r][+i.dataset.c]={src:i.getAttribute('src'),label:i.dataset.l,row:i.dataset.row});
 imgs.forEach(i=>i.onclick=()=>openSet(g,+i.dataset.r,+i.dataset.c));});
document.querySelectorAll('.shots').forEach(box=>{const imgs=[...box.querySelectorAll('img')];const g=[imgs.map(i=>({src:i.getAttribute('src'),label:i.title,row:''}))];
 imgs.forEach((i,k)=>i.onclick=()=>openSet(g,0,k));});
vb.onclick=()=>{if(!vb.classList.contains('full'))vb.classList.add('full');};
let drag=null;vb.onmousedown=e=>{if(vb.classList.contains('full'))drag={x:e.clientX,y:e.clientY,l:vb.scrollLeft,t:vb.scrollTop};};
window.onmousemove=e=>{if(drag){vb.scrollLeft=drag.l-(e.clientX-drag.x);vb.scrollTop=drag.t-(e.clientY-drag.y);}};window.onmouseup=()=>drag=null;
document.getElementById('vx').onclick=()=>v.classList.remove('on');
window.onkeydown=e=>{if(!v.classList.contains('on'))return;if(e.key==='Escape')v.classList.remove('on');
 else if(e.key==='ArrowRight')step(1,0);else if(e.key==='ArrowLeft')step(-1,0);else if(e.key==='ArrowDown')step(0,1);else if(e.key==='ArrowUp')step(0,-1);
 else if(e.key==='z'||e.key==='Z')vb.classList.toggle('full');else return;e.preventDefault();};
"""


def md(text):
    return markdown.markdown(text or "", extensions=["tables", "fenced_code", "sane_lists"])


def inline(text):
    return re.sub(r"^<p>|</p>$", "", md(text).strip())


def esc(s):
    return html.escape(s or "")


def sections(text):
    out, cur = {}, None
    for line in text.splitlines():
        m = HEAD.match(line)
        if m:
            cur = next(s for s in SECTIONS if s.lower() == m.group(1).lower())
            out[cur] = (m.group(2) + "\n") if m.group(2).strip() else ""
        elif cur:
            out[cur] += line + "\n"
    return out


def shots_for(text, night):
    found = []
    for p in re.findall(r"(/[^\s`'\")]*?/shots/[^\s`'\")]+)", text):
        base = Path(p.rstrip(".,:;").split("*")[0])
        if base.suffix == ".png" and base.exists():
            found.append(base)
        elif base.is_dir():
            found += sorted(base.rglob("*.png"))
    seen, res = set(), []
    for c in found:
        if c not in seen and "/frames" not in str(c):
            seen.add(c); res.append(c)
    return [os.path.relpath(c, night) for c in res[:12]]


def card_after(sec):
    m = re.search(r"\bafter\**\s*:\**\s*(.+)", sec.get("Card", ""), re.I)
    return m.group(1).strip() if m else (sec.get("Shipped", "").strip().splitlines() or [""])[0]


def decision_html(n, d, night):
    opts = d.get("options", [])
    rows = d.get("rows") or []
    rec = (d.get("recommend") or "").lower()
    is_rec = [bool(rec) and (o["label"].lower().startswith(rec) or rec in o["label"].lower()) for o in opts]
    def head(i, o):
        badge = "<span class=r>recommended</span>" if is_rec[i] else ""
        note = f"<small>{inline(o['note'])}</small>" if o.get("note") else ""
        return f'<div class="opt{" rec" if is_rec[i] else ""}">{badge}<b>{inline(o["label"])}</b>{note}</div>'

    heads = "".join(head(i, o) for i, o in enumerate(opts))
    if rows:
        cells = ['<div></div>'] + [head(i, o) for i, o in enumerate(opts)]
        for ri, row in enumerate(rows):
            cells.append(f'<div class="rowlabel">{esc(row)}</div>')
            for ci, o in enumerate(opts):
                imgs = o.get("images") or []
                src = imgs[ri] if ri < len(imgs) else None
                if src and (night / src).exists():
                    cells.append(f'<div class="cell"><img loading="lazy" src="{esc(src)}" data-r="{ri}" data-c="{ci}" data-l="{esc(o["label"])}" data-row="{esc(row)}" alt=""></div>')
                else:
                    cells.append('<div class="cell none">not rendered</div>')
        grid = f'<div class="opts" style="grid-template-columns:22px repeat({len(opts)},minmax(220px,1fr))">{"".join(cells)}</div>'
    else:
        grid = f'<div class="opts" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">{heads}</div>'
    return (f'<div class="dec" id="d{n}"><span class="tag">{esc(d.get("project"))}</span>'
            f'<h3><span class="n">{n}</span>{inline(d["q"])}</h3><p class="muted">{inline(d.get("context", ""))}</p>{grid}</div>')


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--night", default=str(CROW / "local/state/night"))
    ap.add_argument("--date", default=dt.date.today().isoformat())
    a = ap.parse_args()
    night = Path(a.night)
    runs = {}
    rj = night.parent / "runs.jsonl"
    if rj.exists():
        for line in rj.read_text().splitlines():
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if r.get("run_id"):
                runs[r["run_id"][:8]] = r
    log = (night / "log.md").read_text() if (night / "log.md").exists() else ""
    sp = night / f"summary-{a.date}.json"
    S = json.loads(sp.read_text()) if sp.exists() else {}
    reports = {p.stem: p.read_text() for p in (night / "reports").glob("*.md") if "." not in p.stem}

    projects = [dict(p, runs=list(p.get("runs", []))) for p in S.get("projects", [])]
    listed = {r["id"] for p in projects for r in p["runs"]}
    for rid, text in sorted(reports.items(), key=lambda kv: runs.get(kv[0], {}).get("started_at", "")):
        if rid in listed:
            continue
        meta = runs.get(rid, {})
        proj = next((p for p in projects if p["name"] == meta.get("project", "other")), None)
        if not proj:
            proj = {"name": meta.get("project", "other"), "verdict": "", "runs": []}
            projects.append(proj)
        proj["runs"].append({"id": rid, "what": meta.get("label", rid), "result": card_after(sections(text)), "where": ""})

    decisions = S.get("decisions", [])
    todo = S.get("todo", [])
    n_runs = sum(len(p["runs"]) for p in projects)
    n_main = sum(1 for p in projects for r in p["runs"] if re.search(r"\b(main|master)\b", r.get("where", "")))
    n_todo = sum(len(g.get("items", [])) for g in todo)

    blocks = []
    for p in projects:
        rows = []
        for r in p["runs"]:
            rid, text = r["id"], reports.get(r["id"], "")
            sec = sections(text)
            t = runs.get(rid, {}).get("started_at", "")
            when = dt.datetime.fromisoformat(t).astimezone().strftime("%H:%M") if t else ""
            shots = shots_for(text, night)
            body = []
            if sec.get("Card"):
                body.append("<h4>Before → after</h4>" + md(sec["Card"]))
            if shots:
                body.append('<h4>Screenshots</h4><div class="shots">' + "".join(
                    f'<img loading="lazy" src="{esc(s)}" title="{esc(Path(s).name)}" alt="">' for s in shots) + "</div>")
            if text:
                body.append(f'<details class="full"><summary>Full report ({rid}, started {when})</summary>{md(text)}</details>')
            rows.append(f'<details class="run"><summary><span class="st">{"✓" if text else "…"}</span><span class="what">{inline(r.get("what"))}</span>'
                        f'<span class="res">{inline(r.get("result"))}</span><span class="where">{esc(r.get("where"))}</span></summary>'
                        f'<div class="body">{"".join(body) or "<p class=muted>No report.</p>"}</div></details>')
        blocks.append(f'<section class="proj"><div class="ph"><span class="meta">{len(p["runs"])} run{"s" * (len(p["runs"]) != 1)}</span>'
                      f'<h3>{esc(p["name"])}</h3><p class="v muted">{inline(p.get("verdict"))}</p></div>{"".join(rows)}</section>')

    def ul(items):
        return "<ul>" + "".join(f"<li>{inline(i)}</li>" for i in items) + "</ul>"

    page = f"""<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Night Report {esc(a.date)}</title><style>{CSS}</style></head><body><main>
<div class="top"><h1>{esc(S.get("title", "Night report " + a.date))}</h1><span class="muted">{esc(S.get("window"))} · rebuilt {dt.datetime.now().strftime("%H:%M")}</span></div>
<div class="chips"><span class="chip"><b>{n_runs}</b> runs</span><span class="chip"><b>{n_main}</b> on main/master</span><span class="chip"><b>{n_runs - n_main}</b> on branches/PRs</span>
<span class="chip"><b>{len(decisions)}</b> decisions</span><span class="chip"><b>{n_todo}</b> checks by hand</span><span class="chip muted">{esc(S.get("accounts"))}</span></div>
<nav><a href="#tldr">TL;DR</a><a href="#decisions">Decisions</a><a href="#hand">By hand</a><a href="#decided">Decided</a><a href="#projects">What ran</a><a href="#log">Log</a></nav>
<h2 id="tldr">TL;DR</h2><div class="box">{ul(S.get("tldr", []))}</div>
<h2 id="decisions">Decisions ({len(decisions)}) <span class="muted" style="font-weight:400;font-size:.85rem">· click an image, ← → flip options, ↑ ↓ scenario, Z zoom</span></h2>
{"".join(decision_html(i + 1, d, night) for i, d in enumerate(decisions)) or '<div class="box muted">None.</div>'}
<h2 id="hand">By hand ({n_todo})</h2><div class="box">{"".join(f"<b>{esc(g['project'])}</b>{ul(g.get('items', []))}" for g in todo) or "<span class=muted>None.</span>"}</div>
<h2 id="decided">Already decided</h2><div class="box">{ul(S.get("decided", []) + S.get("notes", []))}</div>
<h2 id="projects">What ran</h2>{"".join(blocks)}
<h2 id="log">Night log</h2><details class="box"><summary>{len([l for l in log.splitlines() if l.startswith("- ")])} entries</summary><ul class="log">{"".join(f"<li>{esc(l[2:])}</li>" for l in log.splitlines() if l.startswith("- "))}</ul></details>
</main><div id="v"><div id="vbar"><span id="vt"></span><span style="opacity:.7">← → flip · ↑ ↓ scenario · Z zoom · Esc</span><span style="flex:1"></span><button id="vx">Close</button></div>
<div id="vbox"><img id="vi" alt=""></div></div><script>{JS}</script></body></html>"""
    out = night / f"report-{a.date}.html"
    out.write_text(page)
    print(out)


if __name__ == "__main__":
    main()

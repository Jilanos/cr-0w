#!/usr/bin/env python3
"""Session retrospectives: queue finished sessions and analyze them one at a time.

  crow-retro hook            SessionEnd hook entry point (reads the hook JSON on stdin)
  crow-retro add <jsonl>     queue a transcript by hand, then start the worker
  crow-retro work            process the queue (one worker at a time, holds a lock)
  crow-retro retry           requeue retros that failed on a usage limit, then start the worker
  crow-retro status          queue, running worker, last reports

Each queued session is condensed with crow-digest, then analyzed by a headless
cdx run of the /retro skill (on Codex: told to read .claude/skills/retro/SKILL.md). Runs started here carry CROW_RETRO=1 so their own
SessionEnd never queues another retro.
"""
import datetime as dt
import fcntl
import json
import os
import subprocess
import sys
import time

CROW_HOME = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
STATE = os.path.join(CROW_HOME, "local", "state", "retros")
QUEUE = os.path.join(STATE, "queue")
LOCK = os.path.join(STATE, ".worker.lock")
LOG = os.path.join(STATE, "worker.log")
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import crow_cdx  # noqa: E402
# The account comes from crow's policy when the retro runs (CROW_RETRO_ACCOUNT, CROW_ACCOUNT, default);
# an ask-first account is never used unattended. The model is per provider: Codex keeps its account default.
MODELS = {"claude": os.environ.get("CROW_RETRO_MODEL", "sonnet"), "codex": os.environ.get("CROW_RETRO_CODEX_MODEL")}
MIN_USER_MESSAGES = 2


def log(msg):
    os.makedirs(STATE, exist_ok=True)
    with open(LOG, "a", encoding="utf-8") as fh:
        fh.write(f"{dt.datetime.now():%F %T} {msg}\n")


def user_message_count(path):
    """Messages the user typed (not tool results, skill bodies or command wrappers)."""
    count = 0
    with open(path, encoding="utf-8") as fh:
        for raw in fh:
            try:
                ev = json.loads(raw)
            except json.JSONDecodeError:
                continue
            if ev.get("type") != "user":
                continue
            content = (ev.get("message") or {}).get("content")
            if isinstance(content, list):
                if not content or content[0].get("type") != "text":
                    continue
                content = content[0].get("text", "")
            if not isinstance(content, str) or not content.strip():
                continue
            if content.startswith(("<system-reminder>", "<local-command", "Caveat:", "[Request interrupted")):
                continue
            if "Base directory for this skill:" in content:
                continue
            count += 1
    return count


def enqueue(transcript, session_id, cwd, reason):
    if not transcript or not os.path.isfile(transcript):
        return f"skip: no transcript ({transcript})"
    n = user_message_count(transcript)
    if n < MIN_USER_MESSAGES:
        return f"skip: {n} user message(s) in {session_id}"
    os.makedirs(QUEUE, exist_ok=True)
    entry = {"transcript": transcript, "session_id": session_id, "cwd": cwd, "reason": reason,
             "user_messages": n, "queued_at": dt.datetime.now().isoformat(timespec="seconds")}
    with open(os.path.join(QUEUE, f"{session_id}.json"), "w", encoding="utf-8") as fh:
        json.dump(entry, fh)
    return f"queued {session_id} ({n} user messages, {cwd})"


def spawn_worker():
    env = {**os.environ, "CROW_RETRO": "1"}
    subprocess.Popen([os.path.realpath(__file__), "work"], env=env, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     cwd=CROW_HOME)


def cmd_hook():
    if os.environ.get("CROW_RETRO"):
        return 0
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        return 0
    msg = enqueue(data.get("transcript_path"), data.get("session_id") or "unknown",
                  data.get("cwd"), data.get("reason"))
    log(f"hook: {msg}")
    if msg.startswith("queued"):
        spawn_worker()
    return 0


def cmd_add(path):
    session_id = os.path.splitext(os.path.basename(path))[0]
    msg = enqueue(os.path.realpath(path), session_id, None, "manual")
    print(msg)
    if msg.startswith("queued"):
        spawn_worker()
    return 0


def analyze(entry):
    sid = entry["session_id"]
    digest_dir = os.path.join(STATE, "digests")
    os.makedirs(digest_dir, exist_ok=True)
    digest = os.path.join(digest_dir, f"{sid}.md")
    with open(digest, "w", encoding="utf-8") as fh:
        subprocess.run([os.path.join(CROW_HOME, "bin", "crow-digest"), entry["transcript"]],
                       stdout=fh, check=True)
    prompt = (f"/retro digest={digest} transcript={entry['transcript']} "
              f"cwd={entry.get('cwd') or 'unknown'} session={sid}")
    try:
        result, _ = crow_cdx.helper_run("retro", prompt, MODELS, operation="hub-oneshot",
                                        account_env="CROW_RETRO_ACCOUNT", cwd=CROW_HOME)
    except crow_cdx.CdxError as e:
        return {"ok": False, "error": e.message}
    if not result.get("ok"):
        err = result.get("error")
        tail = ""
        for k in ("stdout_path", "stderr_path"):
            try:
                tail += open(result.get(k) or "/nonexistent", errors="replace").read()[-400:]
            except OSError:
                pass
        result["error"] = f"{err.get('message') if isinstance(err, dict) else err} {tail}".strip()
    return result


RETRY_AFTER_S = 20 * 60
MAX_ATTEMPTS = 3


def transient(err):
    """A usage limit (or a provider that refused before doing any work) is worth retrying later."""
    e = err.lower()
    return "limit" in e or ('duration_api_ms":0' in e and 'total_cost_usd":0' in e)


def requeue_failed(force=False):
    """Move transient failures back to the queue once they are old enough (or at once with force)."""
    failed = os.path.join(STATE, "failed")
    if not os.path.isdir(failed):
        return 0
    n = 0
    for f in os.listdir(failed):
        src = os.path.join(failed, f)
        try:
            with open(src, encoding="utf-8") as fh:
                entry = json.load(fh)
        except (OSError, json.JSONDecodeError):
            continue
        if not entry.get("transient") or entry.get("attempts", 0) >= MAX_ATTEMPTS:
            continue
        if not force and time.time() - os.path.getmtime(src) < RETRY_AFTER_S:
            continue
        os.makedirs(QUEUE, exist_ok=True)
        os.replace(src, os.path.join(QUEUE, f))
        n += 1
    return n


def cmd_retry():
    n = requeue_failed(force=True)
    print(f"requeued {n} retro(s)")
    if n:
        spawn_worker()
    return 0


def cmd_work():
    os.makedirs(STATE, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0  # another worker is draining the queue
    requeue_failed()
    while True:
        pending = sorted((os.path.join(QUEUE, f) for f in os.listdir(QUEUE) if f.endswith(".json")),
                         key=os.path.getmtime) if os.path.isdir(QUEUE) else []
        if not pending:
            return 0
        path = pending[0]
        with open(path, encoding="utf-8") as fh:
            entry = json.load(fh)
        log(f"work: analyzing {entry['session_id']}")
        result = analyze(entry)
        if result.get("ok"):
            log(f"work: done {entry['session_id']} run {result.get('run_id')}")
            os.remove(path)
        else:
            err = str(result.get("error"))
            log(f"work: FAILED {entry['session_id']}: {err}")
            entry["attempts"] = entry.get("attempts", 0) + 1
            entry["transient"] = transient(err)
            with open(path, "w", encoding="utf-8") as fh:
                json.dump(entry, fh)
            failed = os.path.join(STATE, "failed")
            os.makedirs(failed, exist_ok=True)
            os.replace(path, os.path.join(failed, os.path.basename(path)))


def cmd_status():
    queued = os.listdir(QUEUE) if os.path.isdir(QUEUE) else []
    print(f"queued: {len(queued)}")
    if os.path.exists(LOG):
        with open(LOG, encoding="utf-8") as fh:
            print("".join(fh.readlines()[-8:]), end="")
    return 0


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__.strip())
        return 1
    if args[0] == "retry":
        return cmd_retry()
    if args[0] == "hook":
        return cmd_hook()
    if args[0] == "add" and len(args) == 2:
        return cmd_add(args[1])
    if args[0] == "work":
        return cmd_work()
    if args[0] == "status":
        return cmd_status()
    print(__doc__.strip(), file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Token usage, cost and limits across cdx accounts, for crow watch, the bar and the brief.

  crow-usage            short text summary
  crow-usage --json     full payload (schema below)
  crow-usage --days N   history window (default 7)
  crow-usage --titles   generate missing session titles now (normally a detached worker does it)
  crow-usage --backfill-projects [--days N]   one-off: re-split the frozen days by project (see below)

Projects: a session's usage is split by the turns that worked in each registered project (local/projects.yaml
paths and their <path>.wt/ worktrees), judged from the paths its tool calls touched (file_path, path, cwd,
`git -C`, `cd`, absolute paths in Bash). A turn without a clear target stays with the previous turn's project;
the first turns count for the session cwd. Frozen days keep the cwd attribution they were saved with, new
daily files carry the split ("attribution": "touched"); --backfill-projects rewrites only by_project of the
frozen days that still have transcripts.

Sources: every Claude transcript in the cdx profiles (interactive sessions and
headless runs alike, subagents folded into their session), `cdx status` for the
usage limits, `rtk gain` for the tokens rtk saved. Costs use cdx's own price
table, so they match `cdx stats` (EXTRA_PRICES fills models it lacks). Per-file totals are cached
by (mtime, size).

Session titles: cdx names every session after its account, so crow asks a small
model (through cdx on an allowed account: Haiku on Claude, the account's model on Codex;
CROW_TITLE_CMD overrides with a shell command) for a 3-6 word title from the
whole session (most edited files and recent prompts weigh more than the opening one),
caches it by session id in local/state/session-titles.json and retitles when the session
grew (4+ prompts and x1.5) or moved project. Dispatch labels and /rename win and are kept.
Without a model the title is "project: most edited files" (else the first prompt).
Bounded to CROW_TITLES_PER_DAY model calls (default 40, ~0.001 USD each on Haiku).

JSON: {generated_at, limits[], today{}, week{}, days[], sessions[], rtk{}, retros{}}
sessions[] also carry projects[] {name, cost_usd, tokens, share_pct} and multi_project; by_project entries carry shared_sessions.
sessions[].limit_share {five_hour_pct, week_pct}: points of its account's current windows the session used (see limit_shares).
"""
import datetime as dt
import fcntl
import functools
import glob
import pwd
import re
import json
import os
import shutil
import subprocess
import sys

import yaml


def _cdx_python():
    cdx = shutil.which("cdx")
    if not cdx:
        return None
    with open(os.path.realpath(cdx), encoding="utf-8", errors="replace") as fh:
        first = fh.readline()
    return first[2:].strip() if first.startswith("#!") else None


def _cdx_site():
    """cdx's own site-packages (pipx venv), borrowed instead of re-exec'ing into an interpreter without yaml."""
    interp = _cdx_python()
    if not interp or interp == sys.executable:
        return None
    try:
        return subprocess.run([interp, "-c", "import cdx_manager, os; print(os.path.dirname(os.path.dirname(cdx_manager.__file__)))"],
                              capture_output=True, text=True, timeout=10).stdout.strip() or None
    except (OSError, subprocess.TimeoutExpired):
        return None


try:
    from cdx_manager.run_usage import estimate_cost, token_prices
except ImportError:
    site = _cdx_site()
    if site:
        sys.path.append(site)
    try:
        from cdx_manager.run_usage import estimate_cost, token_prices
    except ImportError:
        estimate_cost = token_prices = None

CROW_HOME = os.environ.get("CROW_HOME") or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
STATE = os.path.join(CROW_HOME, "local", "state")
CACHE = os.path.join(STATE, "usage-cache.json")
TITLES = os.path.join(STATE, "session-titles.json")
TITLE_LOCK = os.path.join(STATE, ".titles.lock")
CACHE_VERSION = 9
TITLES_PER_RUN = 12
TITLES_PER_DAY = int(os.environ.get("CROW_TITLES_PER_DAY") or 40)  # model calls; ~0.001 USD each on Haiku
EDIT_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}
# Operator-owned escape hatch: a shell command reading the session context on stdin. Without it,
# titles go through cdx on an allowed `use` account (CROW_TITLE_ACCOUNT, CROW_ACCOUNT, default),
# read-only, on that provider's small model; no eligible account means no model call.
TITLE_CMD = os.environ.get("CROW_TITLE_CMD")
TITLE_INSTRUCTIONS = ("You name coding sessions. Reply with a 3-6 word title for the main work of the whole session, "
                      "not its opening prompt, in the language of the prompts, naming the project when it is not "
                      "obvious, Title Case not required, no quotes, no trailing punctuation. Reply with the title only.")
TITLE_MODELS = {"claude": os.environ.get("CROW_TITLE_MODEL", "haiku"), "codex": os.environ.get("CROW_TITLE_CODEX_MODEL")}
PROFILES = os.path.expanduser(os.environ.get("CDX_PROFILES", os.path.join(pwd.getpwuid(os.getuid()).pw_dir, ".cdx/profiles")))
ACTIVE_SECONDS = 120


def run_json(cmd):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=30).stdout
        return json.loads(out)
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return None


CACHE_1H_MULTIPLIER = 2.0  # cdx prices every cache write at the 5-minute rate (1.25x input)
# Models cdx's table lacks (USD per million tokens, Anthropic list prices); cdx's own entries win.
# Haiku 5.5: the rate for prompts up to 100K tokens; longer prompts list at 5x and are not split out.
EXTRA_PRICES = {"claude-haiku-5-5": {"input": 0.10, "output": 0.50}}


@functools.lru_cache(maxsize=1)
def all_prices():
    return {**EXTRA_PRICES, **(token_prices()[0] if token_prices else {})}


def pseudo_model(model):
    """Placeholder entries such as <synthetic> carry no billable tokens of their own."""
    return model.startswith("<") or model == "unknown"


def price(usage, model):
    if pseudo_model(model):
        return 0.0
    if not estimate_cost:
        return None
    prices = all_prices()
    base = {k: v for k, v in usage.items() if k != "cache_1h_tokens"}
    cost = estimate_cost(base, model, prices)
    if cost is None or not usage.get("cache_1h_tokens"):
        return cost
    extra = prices[model]["input"] * (CACHE_1H_MULTIPLIER - 1.25) * usage["cache_1h_tokens"] / 1_000_000
    return cost + extra


NOISE = re.compile(r"<(pasted_content|system-reminder|local-command-[a-z]+|command-[a-z]+)[^>]*>.*?</\1[^>]*>", re.S)
BUILTIN_COMMANDS = {"/clear", "/compact", "/model", "/config", "/resume", "/exit", "/cost", "/status", "/login",
                    "/logout", "/effort", "/fast", "/help", "/context", "/usage", "/permissions", "/plugin", "/mcp",
                    "/rename", "/memory", "/hooks", "/doctor", "/theme", "/agents", "/ide", "/vim", "/rewind"}
COMMAND = re.compile(r"<command-name>([^<]*)</command-name>(?:.*?<command-args>([^<]*)</command-args>)?", re.S)


def typed_prompt(ev):
    """Text the user typed in a user event, without pastes, reminders and command wrappers."""
    if ev.get("type") != "user" or ev.get("isMeta"):
        return None
    content = (ev.get("message") or {}).get("content")
    if isinstance(content, list):
        content = " ".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text")
    if not isinstance(content, str) or "Base directory for this skill:" in content:
        return None
    cmd = COMMAND.search(content)
    if cmd and cmd[1].strip() in BUILTIN_COMMANDS:
        return None
    if cmd and not content.lstrip().startswith("<local-command-caveat>"):
        return " ".join(f"{cmd[1]} {cmd[2] or ''}".split())[:300] or None
    if content.lstrip().startswith(("Caveat:", "[Request interrupted", "<task-notification")):
        return None
    text = " ".join(NOISE.sub(" ", content).split())
    return text or None


def _zero_usage():
    return {"input_tokens": 0, "cache_read_tokens": 0, "cache_creation_tokens": 0, "output_tokens": 0, "cache_1h_tokens": 0}


@functools.lru_cache(maxsize=4096)
def _local_hour(ts_hour):
    """'2026-10-20T13' (UTC) → ('2026-10-20', 15): local date and hour (offsets are whole hours here)."""
    t = dt.datetime.fromisoformat(ts_hour + ":00:00+00:00").astimezone()
    return t.date().isoformat(), t.hour


def tool_label(name):
    """mcp__atlassian__searchJiraIssuesUsingJql → atlassian · searchJiraIssuesUsingJql."""
    if name.startswith("mcp__"):
        parts = name.split("__")
        return f"{parts[1]} · {parts[-1]}" if len(parts) >= 3 else name
    return name


IMAGE_TOKENS = 1600  # a screenshot read back costs roughly this much context, whatever its byte size


def result_tokens(content):
    """(text tokens, images) of a tool_result: text at ~4 chars/token, images counted apart."""
    if isinstance(content, str):
        return len(content) // 4, 0
    text, images = 0, 0
    for c in content or []:
        if not isinstance(c, dict):
            continue
        if c.get("type") == "image":
            images += 1
        else:
            text += len(c.get("text") or "") // 4
    return text, images


# ---------- per-project attribution ----------

def load_registry():
    """[(name, path)] from local/projects.yaml, longest path first (a nested project beats its parent)."""
    try:
        with open(os.path.join(CROW_HOME, "local", "projects.yaml"), encoding="utf-8") as fh:
            reg = yaml.safe_load(fh) or {}
    except (OSError, yaml.YAMLError):
        return []
    out = [(p["name"], os.path.realpath(p["path"]).rstrip("/")) for p in reg.get("projects") or []
           if p.get("name") and p.get("path")]
    return sorted(out, key=lambda e: -len(e[1]))


def registry_sig(registry):
    return "|".join(f"{n}={p}" for n, p in registry)


def project_of(path, registry):
    """Registered project owning an absolute path (or its .wt/ worktree), else None."""
    if not path or not path.startswith("/"):
        return None
    path = os.path.normpath(path)
    for name, root in registry:
        for base in (root, root + ".wt"):
            if path == base or path.startswith(base + "/"):
                return name
    return None


ABS_PATH = re.compile(r"(?<![\w.~$-])(/[A-Za-z0-9_.@+-][^\s\"'`;|&<>()]*)")


def touched_paths(name, inp, cwd):
    """Absolute paths a tool call acted on."""
    if not isinstance(inp, dict):
        return []
    out = []
    for k in ("file_path", "path", "notebook_path", "cwd", "directory"):
        if isinstance(inp.get(k), str):
            out.append(inp[k])
    cmd = inp.get("command")
    if isinstance(cmd, str):
        out += ABS_PATH.findall(cmd)
        for m in re.finditer(r"\bgit\s+-C\s+(\"[^\"]+\"|'[^']+'|\S+)", cmd):
            out.append(m[1].strip("\"'"))
        for m in re.finditer(r"(?:^|[;&|(]\s*|&&\s*)cd\s+(\"[^\"]+\"|'[^']+'|[^\s;&|]+)", cmd):
            out.append(m[1].strip("\"'"))
    return [p if p.startswith("/") else os.path.join(cwd or "/", p) for p in out if p and not p.startswith(("~", "$"))]


def turn_project(blocks, cwd, registry):
    """Project a turn's tool calls point at (majority of the touched paths), or None."""
    votes = {}
    for b in blocks:
        for p in touched_paths(b.get("name"), b.get("input"), cwd):
            proj = project_of(p, registry)
            if proj:
                votes[proj] = votes.get(proj, 0) + 1
    return max(votes, key=votes.get) if votes else None


def add_usage(models, model, usage):
    m = models.setdefault(model or "unknown", _zero_usage())
    m["input_tokens"] += usage.get("input_tokens") or 0
    m["cache_read_tokens"] += usage.get("cache_read_input_tokens") or 0
    m["cache_creation_tokens"] += usage.get("cache_creation_input_tokens") or 0
    m["output_tokens"] += usage.get("output_tokens") or 0
    m["cache_1h_tokens"] += (usage.get("cache_creation") or {}).get("ephemeral_1h_input_tokens") or 0


def scan_transcript(path, registry=None):
    """Usage of one session file (+ its subagents), deduplicated by message id, split by local day.

    Also: tokens each tool returned into the context, compactions, and 10-minute activity
    buckets per day (for the timeline)."""
    seen = set()
    per_day = {}   # date → model → usage
    per_hour = {}  # UTC hour ("2026-10-20T13") → model → usage, for the limit windows
    tools = {}     # label → [calls, text tokens, images]
    names = {}     # tool_use id → label
    active = {}    # date → set of 10-minute buckets
    compactions = 0
    meta = {"title": None, "entrypoint": None, "start": None, "end": None, "cwd": None, "user_messages": 0,
            "prompts": [], "last_prompt": None, "branch": None, "recent": [], "files": {}, "last_cwd": None}
    files = [path] + glob.glob(os.path.join(path[:-6], "subagents", "*.jsonl"))
    registry = load_registry() if registry is None else registry
    turns = []     # (file index, turn) in transcript order; turn = {day, model, usage, blocks}
    for fi, fpath in enumerate(files):
        by_id = {}
        with open(fpath, encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                if ('"usage"' not in raw and '"custom-title"' not in raw and '"type":"user"' not in raw
                        and '"compact_boundary"' not in raw):
                    continue
                try:
                    ev = json.loads(raw)
                except json.JSONDecodeError:
                    continue
                ts = ev.get("timestamp")
                if fpath == path:
                    if ts:
                        meta["start"] = meta["start"] or ts
                        meta["end"] = ts
                    meta["cwd"] = meta["cwd"] or ev.get("cwd")
                    meta["last_cwd"] = ev.get("cwd") or meta["last_cwd"]
                    meta["branch"] = ev.get("gitBranch") or meta["branch"]
                    meta["entrypoint"] = meta["entrypoint"] or ev.get("entrypoint")
                    if ev.get("type") == "custom-title":
                        meta["title"] = ev.get("customTitle")
                    if ev.get("type") == "system" and ev.get("subtype") == "compact_boundary":
                        compactions += 1
                    text = typed_prompt(ev)
                    if text:
                        meta["user_messages"] += 1
                        meta["last_prompt"] = text[:300]
                        meta["recent"] = (meta["recent"] + [text[:200]])[-4:]
                        if len(meta["prompts"]) < 3:
                            meta["prompts"].append(text[:300])
                msg = ev.get("message") or {}
                content = msg.get("content")
                turn = by_id.get(msg.get("id")) if ev.get("type") == "assistant" and msg.get("id") else None
                if isinstance(content, list):
                    for c in content:
                        if not isinstance(c, dict):
                            continue
                        if c.get("type") == "tool_use":
                            names[c.get("id")] = tool_label(c.get("name") or "?")
                            if turn is not None:
                                turn["blocks"].append(c)
                            fp = (c.get("input") or {}).get("file_path") if c.get("name") in EDIT_TOOLS else None
                            if isinstance(fp, str) and fp:
                                base = os.path.basename(fp)
                                meta["files"][base] = meta["files"].get(base, 0) + 1
                        elif c.get("type") == "tool_result":
                            label = names.get(c.get("tool_use_id"), "(unmatched result)")
                            t = tools.setdefault(label, [0, 0, 0])
                            tok, img = result_tokens(c.get("content"))
                            t[0] += 1
                            t[1] += tok
                            t[2] += img
                usage = msg.get("usage")
                if ev.get("type") != "assistant" or not usage or msg.get("id") in seen or not ts:
                    continue
                seen.add(msg.get("id"))
                day, hour = _local_hour(ts[:13])
                active.setdefault(day, set()).add(hour * 6 + int(ts[14:16]) // 10)
                add_usage(per_day.setdefault(day, {}), msg.get("model"), usage)
                add_usage(per_hour.setdefault(ts[:13], {}), msg.get("model"), usage)
                turn = {"day": day, "model": msg.get("model"), "usage": usage,
                        "blocks": [c for c in content if isinstance(c, dict) and c.get("type") == "tool_use"]
                        if isinstance(content, list) else []}
                turns.append((fi, turn))
                if msg.get("id"):
                    by_id[msg["id"]] = turn
    home = project_of(meta["cwd"], registry) or os.path.basename(meta["cwd"] or "") or "?"
    per_proj = {}  # project → date → model → usage
    sticky, last_fi = home, 0
    for fi, turn in turns:
        if fi != last_fi:
            sticky, last_fi = home, fi  # a subagent starts where the session was started
        sticky = turn_project(turn["blocks"], meta["cwd"], registry) or sticky
        add_usage(per_proj.setdefault(sticky, {}).setdefault(turn["day"], {}), turn["model"], turn["usage"])
    per_model = {}
    for models in per_day.values():
        for model, u in models.items():
            tot = per_model.setdefault(model, _zero_usage())
            for k, v in u.items():
                tot[k] += v
    return {"v": CACHE_VERSION, "meta": meta, "per_model": per_model, "per_day": per_day, "per_proj": per_proj, "per_hour": per_hour,
            "reg": registry_sig(registry), "tools": tools,
            "compactions": compactions, "active": {d: sorted(b) for d, b in active.items()}}


# ---------- session titles ----------

def load_titles():
    try:
        with open(TITLES, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}


def real_title(meta, account):
    """A /rename title, unless it is cdx's default (the account name, maybe with a counter)."""
    t = (meta.get("title") or "").strip()
    return t if t and not re.fullmatch(re.escape(account) + r"( \(\d+\))?", t) else None


def clip(text, n):
    return text if len(text) <= n else text[:n - 1].rsplit(" ", 1)[0] + "…"


def dir_project(meta):
    return os.path.basename(meta.get("cwd") or "") or "?"


def fallback_title(meta):
    """Readable title without a model: project, then the files edited most (else the first prompt,
    else the branch), so two sessions in one repo stay tellable apart."""
    project = dir_project(meta)
    files = sorted((meta.get("files") or {}).items(), key=lambda kv: (-kv[1], kv[0]))[:2]
    if files:
        return f"{project}: " + ", ".join(clip(f, 28) for f, _ in files)
    first = (meta.get("prompts") or [None])[0]
    branch = meta.get("branch")
    if first:
        return clip(f"{project}: {first}" if project != "?" else first, 48)
    if branch and branch not in ("main", "master", "HEAD"):
        return f"{project} ({branch})"
    return None


def title_context(meta):
    """What the titler sees: the main work (most edited files, recent prompts) ahead of the opening
    prompt, which is often a small errand."""
    lines = [f"Project: {dir_project(meta)}"]
    if meta.get("branch"):
        lines.append(f"Branch: {meta['branch']}")
    last = os.path.basename(meta.get("last_cwd") or "")
    if last and last != dir_project(meta):
        lines.append(f"Moved to project: {last}")
    files = sorted((meta.get("files") or {}).items(), key=lambda kv: (-kv[1], kv[0]))[:5]
    if files:
        lines.append("Most edited files: " + ", ".join(f"{f} ({n})" for f, n in files))
    lines.append(f"Opening prompt (may be a side errand): {clip((meta.get('prompts') or ['-'])[0], 160)}")
    for i, p in enumerate(meta.get("recent") or []):
        lines.append(f"Recent prompt {i + 1}: {clip(p, 200)}")
    return lines


def budget_left(titles):
    return TITLES_PER_DAY - (titles.get("_calls") or {}).get(dt.date.today().isoformat(), 0)


def spend_call(titles):
    today = dt.date.today().isoformat()
    titles["_calls"] = {today: (titles.get("_calls") or {}).get(today, 0) + 1}  # older days dropped


def session_title(sid, meta, account, titles):
    """/rename title, else generated or dispatch title, else a readable fallback: project + main files (stored as a placeholder
    so crow-runs can show it too, and replaced once the titler has run)."""
    t = real_title(meta, account)
    if t:
        return t
    have = titles.get(sid) or {}
    if have.get("source") != "prompt" and have.get("title"):
        return have["title"]
    t = fallback_title(meta)
    if not t:
        return None
    if have.get("title") != t:
        titles[sid] = {"title": t, "source": "prompt", "prompts": 0}
        titles["_dirty"] = True
    return t


def title_due(s, titles):
    """No generated title yet, or the session grew by 4+ prompts and half again since, or moved to
    another project (2+ new prompts). Dispatch labels and /rename titles are never regenerated."""
    n = s.get("user_messages") or 0
    if not n or s.get("_renamed"):
        return False
    have = titles.get(s["id"])
    if not have or have.get("source") == "prompt":
        return True
    if have.get("source") != "haiku":
        return False
    done = have.get("prompts", 0)
    moved = s.get("project") and have.get("project") and s["project"] != have["project"]
    return (n >= 1.5 * done and n >= done + 4) or bool(moved and n >= done + 2)


def spawn_titler():
    try:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "--titles"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
                         env={**os.environ, "CROW_RETRO": "1"})
    except OSError:
        pass


def ask_title(meta):
    lines = title_context(meta)
    if TITLE_CMD:
        env = {k: v for k, v in os.environ.items() if not k.startswith("CLAUDECODE")}
        env["CROW_RETRO"] = "1"
        try:
            out = subprocess.run(["bash", "-c", TITLE_CMD], input="\n".join(lines), capture_output=True, text=True,
                                 timeout=60, env=env, cwd=STATE)
        except (OSError, subprocess.TimeoutExpired):
            return None
        raw, rc = out.stdout, out.returncode
    else:
        sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
        import crow_cdx
        try:
            res, target = crow_cdx.helper_run("title", TITLE_INSTRUCTIONS + "\n\n" + "\n".join(lines), TITLE_MODELS,
                                              account_env="CROW_TITLE_ACCOUNT", cwd=STATE, timeout=120)
        except crow_cdx.CdxError:
            return None
        raw = crow_cdx.final_text(res.get("stdout_path"), target["provider"]) if res.get("ok") else None
        rc = 0 if raw else 1
    title = " ".join((raw or "").strip().strip("\"'").split())
    if rc != 0 or not title or len(title) > 60 or "log in" in title.lower():
        return None
    return title.rstrip(".")


def generate_titles():
    """Worker: title the most recent sessions that need one. One worker at a time."""
    os.makedirs(STATE, exist_ok=True)
    with open(TITLE_LOCK, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0
        try:
            with open(CACHE, encoding="utf-8") as fh:
                cache = json.load(fh)
        except (OSError, json.JSONDecodeError):
            return 0
        titles = load_titles()
        todo = []
        for path, hit in cache.items():
            meta = hit["data"].get("meta") or {}
            account = path.split(os.sep + "profiles" + os.sep, 1)[-1].split(os.sep, 1)[0]
            s = {"id": os.path.basename(path)[:-6], "user_messages": meta.get("user_messages"),
                 "project": dir_project({"cwd": meta.get("last_cwd")}) if meta.get("last_cwd") else None,
                 "_renamed": bool(real_title(meta, account))}
            if title_due(s, titles):
                todo.append((meta.get("end") or "", s["id"], meta))
        done = 0
        for _, sid, meta in sorted(todo, reverse=True)[:TITLES_PER_RUN]:
            if budget_left(titles) <= 0:
                break  # daily cap reached: placeholders stay readable, resume tomorrow
            spend_call(titles)
            title = ask_title(meta)
            if not title:
                save_titles({**load_titles(), "_calls": titles["_calls"]})
                break  # the command is failing (auth, limit): retry on a later poll
            titles[sid] = {"title": title, "source": "haiku", "prompts": meta.get("user_messages") or 0,
                           "project": dir_project({"cwd": meta.get("last_cwd") or meta.get("cwd")}),
                           "at": dt.datetime.now().isoformat(timespec="seconds")}
            done += 1
            fresh = load_titles()  # the poller may have added labels or placeholders meanwhile
            fresh[sid] = titles[sid]
            fresh["_calls"] = titles["_calls"]
            save_titles(fresh)
        return done


def dispatch_titles(titles):
    """Background runs started by crow: their session takes the dispatch label (mapped once, then cached)."""
    mapped = set(titles.get("_runs") or [])
    try:
        with open(os.path.join(STATE, "runs.jsonl"), encoding="utf-8") as fh:
            recs = [json.loads(l) for l in fh if l.strip()]
    except (OSError, json.JSONDecodeError):
        return False
    changed = False
    for rec in recs:
        rid = rec.get("run_id")
        if not rid or rid in mapped:
            continue
        logs = glob.glob(os.path.join(PROFILES, "*", "claude-home", "log", f"cdx-run-{rid}.stdout.log"))
        sid = None
        for log in logs:
            with open(log, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    m = re.search(r'"session_id":\s*"([0-9a-f-]{36})"', line)
                    if m:
                        sid = m[1]
                        break
        if not sid:
            continue  # still running, or no log: try again on a later poll
        titles[sid] = {"title": rec.get("label"), "source": "dispatch", "prompts": 10 ** 6}
        mapped.add(rid)
        changed = True
    if changed:
        titles["_runs"] = sorted(mapped)
        save_titles(titles)
    return changed


def save_titles(titles):
    tmp = TITLES + f".{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(titles, fh)
    os.replace(tmp, TITLES)


def live_session_ids():
    """Session ids of running Claude processes (same source as crow-runs), or None if unknown."""
    ids, seen_any = set(), False
    for f in glob.glob(os.path.join(PROFILES, "*", "claude-home", ".claude", "sessions", "*.json")):
        seen_any = True
        try:
            pid = int(os.path.basename(f)[:-5])
            os.kill(pid, 0)
            with open(f, encoding="utf-8") as fh:
                sid = json.load(fh).get("sessionId")
        except (ValueError, OSError, json.JSONDecodeError):
            continue
        if sid:
            ids.add(sid)
    return ids if seen_any else None


TOP_MODEL = os.environ.get("CROW_TOP_MODEL", "claude-opus-5-5")
RECENT_DAY = (dt.date.today() - dt.timedelta(days=1)).isoformat()  # activity buckets kept for today + yesterday
HOUR_CUTOFF = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=8)).strftime("%Y-%m-%dT%H")  # covers a weekly window


def cache_read_price(prices, model):
    p = prices.get(model) or {}
    return p.get("cache_read", (p.get("input") or 0) * 0.1)


def figures(per_model):
    """Totals, cost and what caching / cheaper models saved, for {model: usage}."""
    totals = {"input_tokens": 0, "cache_read_tokens": 0, "cache_creation_tokens": 0, "output_tokens": 0}
    cost, priced, cache_saved, routing_saved = 0.0, True, 0.0, 0.0
    prices = all_prices()
    for model, usage in per_model.items():
        for k in totals:
            totals[k] += usage.get(k, 0)
        c = price(usage, model)
        if c is None:
            priced = False
            continue
        cost += c
        if pseudo_model(model) or model not in prices:
            continue
        # Cache reads billed at the cache price instead of full input price.
        cache_saved += usage.get("cache_read_tokens", 0) * (prices[model]["input"] - cache_read_price(prices, model)) / 1e6
        if model != TOP_MODEL and TOP_MODEL in prices:
            top = price(usage, TOP_MODEL)
            if top is not None:
                routing_saved += max(0.0, top - c)
    return {"totals": totals, "cost_usd": cost, "priced": priced, "cache_saved_usd": cache_saved,
            "routing_saved_usd": routing_saved}


def slim(f):
    t = f["totals"]
    return {"cost_usd": round(f["cost_usd"], 4) if f["priced"] else None, "tokens": sum(t.values()),
            "input_tokens": t["input_tokens"], "output_tokens": t["output_tokens"],
            "cache_write_tokens": t["cache_creation_tokens"], "cache_read_tokens": t["cache_read_tokens"],
            "cache_saved_usd": round(f["cache_saved_usd"], 4), "routing_saved_usd": round(f["routing_saved_usd"], 4)}


def collect_sessions(days):
    cutoff = dt.datetime.now().timestamp() - days * 86400
    try:
        with open(CACHE, encoding="utf-8") as fh:
            cache = json.load(fh)
    except (OSError, json.JSONDecodeError):
        cache = {}
    fresh = {}
    sessions = []
    registry = load_registry()
    sig = registry_sig(registry)
    titles = load_titles()
    dispatch_titles(titles)
    live = live_session_ids()
    due = False
    for path in glob.glob(os.path.join(PROFILES, "*", "claude-home", ".claude", "projects", "*", "*.jsonl")):
        st = os.stat(path)
        if st.st_mtime < cutoff:
            continue
        key = f"{st.st_mtime}:{st.st_size}"
        hit = cache.get(path)
        fresh_hit = hit and hit["key"] == key and hit["data"].get("v") == CACHE_VERSION and hit["data"].get("reg") == sig
        data = hit["data"] if fresh_hit else scan_transcript(path, registry)
        fresh[path] = {"key": key, "data": data}
        if not data["per_model"]:
            continue
        account = path.split(os.sep + "profiles" + os.sep, 1)[1].split(os.sep, 1)[0]
        f = figures(data["per_model"])
        totals, cost, priced = f["totals"], f["cost_usd"], f["priced"]
        by_day = {d: figures(models) for d, models in (data.get("per_day") or {}).items()}
        meta = data["meta"]
        by_day_project = {}
        proj_tot = {}
        for proj, days_ in (data.get("per_proj") or {}).items():
            for d, models in days_.items():
                x = figures(models)
                by_day_project.setdefault(d, {})[proj] = slim(x)
                t = proj_tot.setdefault(proj, {"cost_usd": 0.0, "tokens": 0, "priced": True})
                t["tokens"] += sum(x["totals"].values())
                t["cost_usd"] += x["cost_usd"]
                t["priced"] = t["priced"] and x["priced"]
        whole = sum(t["tokens"] for t in proj_tot.values()) or 1
        projects = sorted(({"name": n, "cost_usd": round(t["cost_usd"], 4) if t["priced"] else None,
                            "tokens": t["tokens"], "share_pct": round(100 * t["tokens"] / whole)}
                           for n, t in proj_tot.items()), key=lambda e: -e["tokens"])
        tokens = sum(totals.values())
        sid = os.path.basename(path)[:-6]
        if not real_title(meta, account) and title_due({"id": sid, "user_messages": meta["user_messages"],
                                                               "project": dir_project({"cwd": meta.get("last_cwd")}) if meta.get("last_cwd") else None}, titles):
            due = True
        sessions.append({
            "id": sid,
            "account": account,
            "project": os.path.basename(meta["cwd"] or "") or "?",
            "title": session_title(sid, meta, account, titles),
            "branch": meta["branch"],
            "kind": "run" if meta["entrypoint"] == "sdk-cli" else "interactive",
            "models": sorted(data["per_model"]),
            "start": meta["start"],
            "end": meta["end"],
            "active": sid in live if live is not None else dt.datetime.now().timestamp() - st.st_mtime < ACTIVE_SECONDS,
            "user_messages": meta["user_messages"],
            "tokens": tokens,
            "input_tokens": totals["input_tokens"],
            "output_tokens": totals["output_tokens"],
            "cache_write_tokens": totals["cache_creation_tokens"],
            "cache_read_tokens": totals["cache_read_tokens"],
            "cache_pct": round(100 * totals["cache_read_tokens"] / tokens) if tokens else 0,
            "cost_usd": round(cost, 4) if priced else None,
            "cache_saved_usd": round(f["cache_saved_usd"], 4),
            "routing_saved_usd": round(f["routing_saved_usd"], 4),
            "compactions": data.get("compactions") or 0,
            "tools": data.get("tools") or {},
            "by_day": {d: slim(x) for d, x in by_day.items()},
            "projects": projects,
            "multi_project": len(projects) > 1,
            "by_day_project": by_day_project,
            "activity": {d: b for d, b in (data.get("active") or {}).items() if d >= RECENT_DAY},
            "hours": {h: figures(models)["cost_usd"] for h, models in (data.get("per_hour") or {}).items() if h >= HOUR_CUTOFF},
        })
    os.makedirs(STATE, exist_ok=True)
    with open(CACHE, "w", encoding="utf-8") as fh:
        json.dump(fresh, fh)
    sessions.sort(key=lambda s: s["end"] or "", reverse=True)
    if titles.pop("_dirty", False):
        merged = load_titles()
        for sid, t in titles.items():
            if not sid.startswith("_") and t != merged.get(sid) and (sid not in merged or merged[sid].get("source") == "prompt"):
                merged[sid] = t
        save_titles(merged)
    if due and not os.environ.get("CROW_TITLES_OFF"):
        spawn_titler()
    return sessions


def local_day(ts):
    return dt.datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone().date().isoformat()


TOKEN_KEYS = ("input_tokens", "output_tokens", "cache_write_tokens", "cache_read_tokens")


def rtk_homes():
    """Every HOME with an rtk history: the real one and each cdx profile (cdx sandboxes HOME)."""
    homes = [pwd.getpwuid(os.getuid()).pw_dir] + glob.glob(os.path.join(PROFILES, "*", "claude-home"))
    return [h for h in dict.fromkeys(homes) if os.path.exists(os.path.join(h, ".local", "share", "rtk", "history.db"))]


def rtk_stats(today):
    """rtk gain summed over every history database, plus today's share."""
    tot = {"saved_tokens": 0, "input_tokens": 0, "commands": 0, "time_ms": 0, "today_saved_tokens": 0,
           "today_input_tokens": 0, "today_commands": 0, "databases": 0}
    for home in rtk_homes():
        env = {k: v for k, v in os.environ.items() if k != "XDG_DATA_HOME"}
        env["HOME"] = home
        try:
            out = subprocess.run(["rtk", "gain", "--daily", "--format", "json"], capture_output=True, text=True,
                                 timeout=30, env=env).stdout
            data = json.loads(out)
        except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
            continue
        sm = data.get("summary") or {}
        tot["databases"] += 1
        tot["saved_tokens"] += sm.get("total_saved") or 0
        tot["input_tokens"] += sm.get("total_input") or 0
        tot["commands"] += sm.get("total_commands") or 0
        tot["time_ms"] += sm.get("total_time_ms") or 0
        for d in data.get("daily") or []:
            if d.get("date") == today:
                tot["today_saved_tokens"] += d.get("saved_tokens") or 0
                tot["today_input_tokens"] += d.get("input_tokens") or 0
                tot["today_commands"] += d.get("commands") or 0
    if not tot["databases"]:
        return {"saved_tokens": None, "saved_pct": None, "commands": None}
    pct = lambda saved, inp: round(100 * saved / inp, 1) if inp else None
    return {**tot, "saved_pct": pct(tot["saved_tokens"], tot["input_tokens"]),
            "today_saved_pct": pct(tot["today_saved_tokens"], tot["today_input_tokens"])}


DAYS_STORE = os.path.join(STATE, "usage-days.json")
SAMPLES = os.path.join(STATE, "limit-samples.jsonl")
PROJECT_VIEW = os.path.join(STATE, "usage-projects.json")
HISTORY_DAYS = 30
ROLL_KEYS = ("cost_usd", "tokens", "input_tokens", "output_tokens", "cache_write_tokens", "cache_read_tokens",
             "cache_saved_usd", "routing_saved_usd")


def rollup(slices):
    """Sum day slices [(session, slice)] into one figure set with breakdowns."""
    r = {k: 0 for k in ROLL_KEYS}
    r.update(cost_usd=0.0, sessions=0, unpriced=0, runs=0, routed_runs=0, compactions=0)
    by_project, by_model, tools = {}, {}, {}
    for s, x in slices:
        for k in ROLL_KEYS:
            r[k] += x.get(k) or 0
        r["sessions"] += 1
        r["unpriced"] += x.get("cost_usd") is None
        r["runs"] += s["kind"] == "run"
        r["routed_runs"] += s["kind"] == "run" and (x.get("routing_saved_usd") or 0) > 0
        split = x.get("_projects") or {s["project"]: x}
        for name, px in split.items():
            p = by_project.setdefault(name, {"cost_usd": 0.0, "tokens": 0, "sessions": 0, "shared_sessions": 0})
            p["cost_usd"] += px.get("cost_usd") or 0
            p["tokens"] += px.get("tokens") or 0
            p["sessions"] += 1
            p["shared_sessions"] += len(split) > 1
        main = next((m for m in s["models"] if not pseudo_model(m)), "?").replace("claude-", "")
        m = by_model.setdefault(main, {"cost_usd": 0.0, "tokens": 0, "sessions": 0})
        m["cost_usd"] += x.get("cost_usd") or 0
        m["tokens"] += x.get("tokens") or 0
        m["sessions"] += 1
        if x.get("_last"):  # whole-session counters land on the session's last day
            r["compactions"] += s.get("compactions") or 0
            for name, (calls, tok, img) in (s.get("tools") or {}).items():
                t = tools.setdefault(name, [0, 0, 0])
                t[0] += calls
                t[1] += tok
                t[2] += img
    for k in ("cost_usd", "cache_saved_usd", "routing_saved_usd"):
        r[k] = round(r[k], 2)
    r["cache_pct"] = round(100 * r["cache_read_tokens"] / r["tokens"]) if r["tokens"] else 0
    order = lambda d: sorted(({"name": k, **{kk: (round(vv, 2) if isinstance(vv, float) else vv) for kk, vv in v.items()}}
                              for k, v in d.items()), key=lambda e: -e["cost_usd"])
    r["by_project"], r["by_model"] = order(by_project), order(by_model)
    r["attribution"] = "touched"
    r["tools"] = sorted(({"name": k, "calls": c, "tokens": t + i * IMAGE_TOKENS, "text_tokens": t, "images": i}
                         for k, (c, t, i) in tools.items()), key=lambda e: -e["tokens"])
    return r


def merge(rollups):
    """Combine day rollups into a period (week, month)."""
    r = {k: 0 for k in ROLL_KEYS}
    r.update(cost_usd=0.0, sessions=0, unpriced=0, runs=0, routed_runs=0, compactions=0)
    groups = {"by_project": {}, "by_model": {}}
    tools = {}
    for d in rollups:
        for k in r:
            r[k] += d.get(k) or 0
        for g in groups:
            for e in d.get(g) or []:
                x = groups[g].setdefault(e["name"], {"cost_usd": 0.0, "tokens": 0, "sessions": 0, "shared_sessions": 0})
                for k in x:
                    x[k] += e.get(k) or 0
        for e in d.get("tools") or []:
            x = tools.setdefault(e["name"], {"calls": 0, "tokens": 0, "text_tokens": 0, "images": 0})
            for k in x:
                x[k] += e.get(k) or 0
    for k in ("cost_usd", "cache_saved_usd", "routing_saved_usd"):
        r[k] = round(r[k], 2)
    r["cache_pct"] = round(100 * r["cache_read_tokens"] / r["tokens"]) if r["tokens"] else 0
    for g, d in groups.items():
        r[g] = sorted(({"name": k, **{kk: round(vv, 2) if isinstance(vv, float) else vv for kk, vv in v.items()}}
                       for k, v in d.items()), key=lambda e: -e["cost_usd"])
    r["tools"] = sorted(({"name": k, **v} for k, v in tools.items()), key=lambda e: -e["tokens"])
    return r


def load_store():
    try:
        with open(DAYS_STORE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}


def save_store(store):
    tmp = DAYS_STORE + f".{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(store, fh)
    os.replace(tmp, DAYS_STORE)


def reset_dt(text, now):
    """cdx reset strings ('Oct 20 15:00') → aware datetime, assuming the nearest year."""
    try:
        t = dt.datetime.strptime(f"{now.year} {text}", "%Y %b %d %H:%M").astimezone()
    except (TypeError, ValueError):
        return None
    return t.replace(year=now.year + 1) if t < now - dt.timedelta(days=200) else t


def burn_rates(limits):
    """Record a limit sample per account (at most once a minute) and derive the 5h burn over the last hour:
    % per hour and, if it runs out before the reset, when it hits zero."""
    now = dt.datetime.now().astimezone()
    samples = []
    try:
        with open(SAMPLES, encoding="utf-8") as fh:
            samples = [json.loads(l) for l in fh if l.strip()]
    except (OSError, json.JSONDecodeError):
        samples = []
    keep = [x for x in samples if now.timestamp() - x["t"] < 6 * 3600]
    last = max((x["t"] for x in keep), default=0)
    if now.timestamp() - last >= 60:
        keep += [{"t": now.timestamp(), "a": l["account"], "h5": l["remaining_5h_pct"], "wk": l["remaining_week_pct"]}
                 for l in limits if l.get("remaining_5h_pct") is not None]
        tmp = SAMPLES + f".{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write("".join(json.dumps(x) + "\n" for x in keep))
        os.replace(tmp, SAMPLES)
    for l in limits:
        l["burn_5h_pct_per_h"], l["empty_at"] = None, None
        pts = [x for x in keep if x["a"] == l["account"] and now.timestamp() - x["t"] <= 3600]
        # Only since the last reset (remaining jumped up).
        for i in range(len(pts) - 1, 0, -1):
            if pts[i]["h5"] > pts[i - 1]["h5"]:
                pts = pts[i:]
                break
        if len(pts) < 2 or pts[-1]["t"] - pts[0]["t"] < 600:
            continue
        rate = (pts[0]["h5"] - pts[-1]["h5"]) / ((pts[-1]["t"] - pts[0]["t"]) / 3600)
        l["burn_5h_pct_per_h"] = round(rate, 1)
        if rate > 0.5 and l["remaining_5h_pct"]:
            empty = now + dt.timedelta(hours=l["remaining_5h_pct"] / rate)
            reset = reset_dt(l.get("reset_5h_at"), now)
            if reset is None or empty < reset:
                l["empty_at"] = empty.isoformat(timespec="minutes")
    return limits


LIMIT_WINDOWS = (("five_hour_pct", "remaining_5h_pct", "reset_5h_at", dt.timedelta(hours=5)),
                 ("week_pct", "remaining_week_pct", "reset_week_at", dt.timedelta(days=7)))


def limit_shares(sessions, limits, now):
    """Each session's part of its account's current 5h and weekly windows, in points of the window:
    its cost since the window opened over the account's, times the share of the window used.
    Hour granularity; sets s["limit_share"] = {five_hour_pct, week_pct} (None when unknown)."""
    windows = {}  # (account, key) → (first UTC hour, % used)
    for l in limits:
        for key, left, reset, span in LIMIT_WINDOWS:
            r = reset_dt(l.get(reset), now)
            if l.get(left) is not None and r is not None:
                windows[(l["account"], key)] = ((r - span).astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H"), 100 - l[left])
    spent, total = {}, {}
    for s in sessions:
        for key, *_ in LIMIT_WINDOWS:
            w = windows.get((s["account"], key))
            if w:
                c = sum(v for h, v in (s.get("hours") or {}).items() if h >= w[0])
                spent[(s["id"], key)] = c
                total[(s["account"], key)] = total.get((s["account"], key), 0) + c
    for s in sessions:
        s["limit_share"] = {}
        for key, *_ in LIMIT_WINDOWS:
            w, tot = windows.get((s["account"], key)), total.get((s["account"], key))
            s["limit_share"][key] = round(spent[(s["id"], key)] / tot * w[1], 1) if w and tot else None
    return sessions


def rtk_failures():
    """Commands rtk could not filter and ran raw, summed over every database."""
    total = 0
    for home in rtk_homes():
        env = {k: v for k, v in os.environ.items() if k != "XDG_DATA_HOME"}
        env["HOME"] = home
        try:
            out = subprocess.run(["rtk", "gain", "--failures"], capture_output=True, text=True, timeout=30, env=env).stdout
        except (OSError, subprocess.TimeoutExpired):
            continue
        m = re.search(r"Total failures:\s*(\d+)", out)
        total += int(m[1]) if m else 0
    return total


def resolve_days(window, live, store):
    """Per-day rollups for the scan window, oldest first; updates store in place.

    Finished days read from the store, frozen once the day is over, so history survives
    transcript cleanup. Only today and yesterday (late writes after midnight) are recomputed
    from transcripts; yesterday is saved on every run so it freezes when it ages out.
    A finished day missing from the store is frozen from the transcripts, when it has any.
    Returns ({date: rollup}, store_changed)."""
    out, changed = {}, False
    for i, d in enumerate(window):
        recent = i >= len(window) - 2
        if d in store and not recent:
            out[d] = store[d]
            continue
        out[d] = live[d] if live[d]["sessions"] or d not in store else store[d]
        if i < len(window) - 1 and live[d]["sessions"] and store.get(d) != live[d]:
            store[d] = live[d]
            changed = True
    return out, changed


def live_rollups(sessions, window):
    slices = {d: [] for d in window}
    for s in sessions:
        last = max(s["by_day"]) if s["by_day"] else None
        for d, x in s["by_day"].items():
            if d in slices:
                slices[d].append((s, {**x, "_last": d == last, "_projects": s["by_day_project"].get(d)}))
    return {d: rollup(slices[d]) for d in window}


def backfill_projects(days):
    """One-off: give the frozen days the touched-project split. Only by_project (and its marker) is replaced,
    and only where the transcripts still cover the whole day (as many sessions as were frozen)."""
    window = [(dt.date.today() - dt.timedelta(days=i)).isoformat() for i in reversed(range(days))]
    live = live_rollups(collect_sessions(days), window)
    store = load_store()
    done, skipped = [], []
    for d in window[:-1]:
        old = store.get(d)
        if not old or old.get("attribution") == "touched":
            continue
        if live[d]["sessions"] < old.get("sessions", 0):
            skipped.append(d)
            continue
        old["by_project"], old["attribution"] = live[d]["by_project"], "touched"
        done.append(d)
    if done:
        save_store(store)
    return done, skipped


def write_project_view(data):
    """Small file for crow-runs: today's per-project totals and each session's split."""
    view = {"date": dt.date.today().isoformat(), "today": data["today"]["by_project"],
            "sessions": {s["id"]: {"projects": s["projects"], "multi_project": s["multi_project"]}
                         for s in data["sessions"] if s["multi_project"]}}
    tmp = PROJECT_VIEW + f".{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(view, fh)
    os.replace(tmp, PROJECT_VIEW)


def build(days):
    sessions = collect_sessions(max(days, 7))
    today = dt.date.today().isoformat()
    window = [(dt.date.today() - dt.timedelta(days=i)).isoformat() for i in reversed(range(max(days, 7)))]
    live = live_rollups(sessions, window)
    # Past days in the scan window are complete: freeze them so history outlives transcript cleanup.
    store = load_store()
    days, changed = resolve_days(window, live, store)
    if changed:
        save_store(store)
    hist_dates = [(dt.date.today() - dt.timedelta(days=i)).isoformat() for i in reversed(range(HISTORY_DAYS))]
    history = [{"date": d, **(days.get(d) or store.get(d) or rollup([]))} for d in hist_dates]
    status = run_json(["cdx", "status", "--json"]) or {}
    limits = burn_rates([{
        "account": r.get("session_name"),
        "remaining_5h_pct": r.get("remaining_5h_pct"),
        "reset_5h_at": r.get("reset_5h_at"),
        "remaining_week_pct": r.get("remaining_week_pct"),
        "reset_week_at": r.get("reset_week_at"),
        "active": r.get("active"),
    } for r in status.get("rows", []) if r.get("provider") == "claude"])
    retro_dir = os.path.join(STATE, "retros")
    proposals = os.path.join(retro_dir, "proposals.md")
    pending = 0
    if os.path.exists(proposals):
        with open(proposals, encoding="utf-8") as fh:
            pending = sum(1 for line in fh if line.startswith("- [ ]"))
    limit_shares(sessions, limits, dt.datetime.now().astimezone())
    rtk = rtk_stats(today)
    rtk["failures"] = rtk_failures()
    week = merge([h for h in history[-7:]])
    month = merge(history)
    strip = lambda r: {k: v for k, v in r.items() if k not in ("by_project", "by_model", "tools")}
    for s in sessions:
        s["today"] = s["by_day"].get(today)
        s.pop("tools", None)
        s.pop("by_day_project", None)
        s.pop("hours", None)
    out = {
        "generated_at": dt.datetime.now().isoformat(timespec="seconds"),
        "limits": limits,
        "today": live[today],
        "week": week,
        "month": month,
        "days": [{"date": d, **strip(days[d])} for d in window[-7:]],
        "history": [{"date": h["date"], **strip(h)} for h in history],
        "sessions": sessions,
        "rtk": rtk,
        "retros": {"today": len(glob.glob(os.path.join(retro_dir, f"{today}-*.md"))), "pending_proposals": pending,
                   "week": sum(len(glob.glob(os.path.join(retro_dir, f"{d}-*.md"))) for d in window[-7:])},
    }
    write_project_view(out)
    return out


def human(n):
    if n is None:
        return "?"
    for unit, size in (("M", 1e6), ("k", 1e3)):
        if n >= size:
            return f"{n / size:.1f}{unit}"
    return str(n)


def main():
    args = sys.argv[1:]
    if "--titles" in args:
        print(f"{generate_titles()} titles written to {TITLES}")
        return 0
    days = int(args[args.index("--days") + 1]) if "--days" in args else 7
    if "--backfill-projects" in args:
        done, skipped = backfill_projects(max(days, HISTORY_DAYS) if "--days" not in args else days)
        print(f"{len(done)} frozen days re-split by project" + (f": {', '.join(done)}" if done else ""))
        if skipped:
            print(f"left as they were (transcripts no longer cover them): {', '.join(skipped)}")
        return 0
    data = build(days)
    if "--json" in args:
        json.dump(data, sys.stdout)
        sys.stdout.write("\n")
        return 0
    for lim in data["limits"]:
        print(f"{lim['account']:<8} 5h {lim['remaining_5h_pct']}% left (↻ {lim['reset_5h_at']})  "
              f"week {lim['remaining_week_pct']}% left (↻ {lim['reset_week_at']})")
    t = data["today"]
    print(f"today    ${t['cost_usd']:.2f} · {human(t['tokens'])} tok ({t['cache_pct']}% cache reads) · {t['sessions']} sessions")
    spark = "▁▂▃▄▅▆▇█"
    peak = max((d["cost_usd"] for d in data["days"]), default=0) or 1
    print("7 days   " + "".join(spark[min(7, int(d["cost_usd"] / peak * 7))] for d in data["days"])
          + "  " + " ".join(f"${d['cost_usd']:.0f}" for d in data["days"]))
    bp = data["today"]["by_project"]
    if bp:
        print("by project today (turns that worked there; * = sessions shared with another project)")
        for e in bp[:8]:
            print(f"  {e['name'][:24]:<24} {human(e['tokens']):>7} {'$%.2f' % e['cost_usd']:>7}  "
                  f"{e['sessions']} sessions{'*' if e['shared_sessions'] else ''}")
    r = data["rtk"]
    print(f"rtk      trimmed {human(r.get('today_saved_tokens'))} tok of command output today, "
          f"{human(r['saved_tokens'])} all time ({round(r['saved_pct'] or 0)}%)")
    for s in [s for s in data["sessions"] if s["end"] and local_day(s["end"]) == dt.date.today().isoformat()][:10]:
        cost = f"${s['cost_usd']:.2f}" if s["cost_usd"] is not None else "?"
        mark = "●" if s["active"] else ("⚙" if s["kind"] == "run" else "✓")
        print(f"  {mark} {s['project'][:18]:<18} {(s['title'] or '')[:40]:<40} {human(s['tokens']):>7} {cost:>7}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

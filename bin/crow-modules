#!/usr/bin/env python3
"""crow-modules: which bricks are on (adr_002). Read only.

  crow-modules         one line per brick: on/off, default, summary; crow.yaml problems on stderr
  crow-modules json    {file, exists, modules: [{name, on, default, summary, requires, config}], errors}

Bricks come from the engine manifests (modules/<brick>.yaml). Switches and config come from
crow.yaml at the CROW_HOME root, else local/crow.yaml. A missing file or key keeps the default.
`crow doctor` fails on the errors listed here.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import crow_lib  # noqa: E402


def report(home=None, engine=None):
    st = crow_lib.load_modules(home, engine)
    man = crow_lib.engine_manifests(engine)
    rows = [{"name": n, "on": m["on"], "default": m["default"], "summary": man[n].get("summary", ""),
             "requires": man[n].get("requires") or [], "config": m["config"]}
            for n, m in sorted(st["modules"].items())]
    return {"file": st["file"], "exists": st["exists"], "modules": rows, "errors": st["errors"]}


def main(argv):
    if argv not in ([], ["json"]):
        sys.exit(__doc__)
    r = report()
    if argv:
        json.dump(r, sys.stdout)
        print()
        return 0
    print(f"crow.yaml: {r['file']}" + ("" if r["exists"] else " (none, defaults)"))
    for m in r["modules"]:
        flag = "on " if m["on"] else "off"
        note = "" if m["on"] == m["default"] else " (default " + ("on" if m["default"] else "off") + ")"
        print(f"{flag}  {m['name']:<18} {m['summary']}{note}")
    for e in r["errors"]:
        print(f"crow-modules: {e['file']}: {e['key'] or '(file)'}: {e['error']}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

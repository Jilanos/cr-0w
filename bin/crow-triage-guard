#!/usr/bin/env python3
"""Fail-closed PreToolUse guard for one immutable message-level manifest."""
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from crow_panel.security import tool_allowed

try:
    manifest = json.loads(Path(sys.argv[1]).read_text())
    payload = json.load(sys.stdin)
    allowed = tool_allowed("triage", payload["tool_name"], payload["tool_input"], manifest)
except Exception:
    allowed = False
if not allowed:
    print("Tool or message outside the confirmed manifest.", file=sys.stderr)
    sys.exit(2)

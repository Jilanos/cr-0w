#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["textual>=1.0", "pyyaml"]
# ///
"""crow watch: live board of every agent (background runs, sessions, finished runs).

Layout follows the lazygit / gh-dash pattern: agent list on the left, details of
the selected agent on the right, key hints at the bottom. Data comes from
crow-runs' collect(), the same source as `crow-runs json`.
"""
import time
from datetime import datetime
from importlib.machinery import SourceFileLoader
from pathlib import Path

from rich.text import Text
from textual import work
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Horizontal, VerticalScroll
from textual.widgets import DataTable, Footer, Markdown, Static

runs = SourceFileLoader("crow_runs", str(Path(__file__).resolve().with_name("crow-runs"))).load_module()

STATE = {  # glyph, style, label
    "working": ("●", "bold green", "working"),
    "quiet": ("◌", "yellow", "quiet"),
    "waiting": ("◆", "bold magenta", "needs you"),
    "idle": ("○", "bright_black", "idle"),
    "done": ("✓", "green", "done"),
    "failed": ("✗", "bold red", "failed"),
    "limit": ("⏸", "yellow", "usage limit"),
    "lost": ("?", "bright_black", "lost"),
}


def ago(s):
    return runs.fmt_age(max(0, s)) if s is not None else "–"


def ctx_cell(tokens):
    if not tokens:
        return Text("–", style="bright_black")
    k = tokens // 1000
    style = "green" if k < 150 else "yellow" if k < 400 else "bold red"
    return Text(f"{k}k", style=style)


def ts_local(iso):
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone().strftime("%H:%M:%S")
    except (AttributeError, ValueError):
        return "        "


class CrowWatch(App):
    TITLE = "crow watch"
    ENABLE_COMMAND_PALETTE = False
    # Terminal-native look: no painted backgrounds, only the terminal's 16 ANSI colours,
    # so the user's theme and transparency show through (same conventions as lazytf).
    CSS = """
    Screen { layout: vertical; background: ansi_default; }
    #title { height: 1; width: 100%; content-align: center middle; background: ansi_magenta; color: ansi_black; text-style: bold; }
    #summary { height: 3; padding: 0 1; border: round ansi_bright_black; background: ansi_default; }
    #main { height: 1fr; background: ansi_default; }
    #agents { width: 5fr; min-width: 60; height: 100%; background: ansi_default; border: round ansi_bright_black; }
    #agents:focus-within { border: round ansi_bright_blue; }
    #detail { width: 2fr; min-width: 34; padding: 0 1; background: ansi_default; border: round ansi_bright_black; }
    #detail:focus-within { border: round ansi_bright_blue; }
    #detail-head, #timeline { text-wrap: nowrap; text-overflow: ellipsis; }
    #detail-head { margin-bottom: 1; }
    #report { margin-top: 1; background: ansi_default; }
    DataTable { background: ansi_default; overflow-x: hidden; scrollbar-size-vertical: 1;
                scrollbar-background: ansi_default; scrollbar-color: ansi_bright_black; }
    DataTable > .datatable--header { background: ansi_default; color: ansi_magenta; text-style: bold; }
    DataTable > .datatable--cursor { background: ansi_bright_blue; color: ansi_black; }
    DataTable > .datatable--hover { background: ansi_default; }
    DataTable:focus > .datatable--cursor { background: ansi_bright_blue; color: ansi_black; }
    Footer { background: ansi_default; color: ansi_default; }
    Footer .footer-key--key { background: ansi_default; color: ansi_magenta; }
    Footer .footer-key--description { background: ansi_default; color: ansi_default; }
    .narrow #main { layout: vertical; }
    .narrow #agents, .narrow #detail { width: 100%; min-width: 0; }
    .narrow #agents { height: auto; max-height: 50%; }
    .narrow #detail { height: 1fr; }
    """
    BINDINGS = [
        Binding("q", "quit", "quit"),
        Binding("r", "refresh", "refresh"),
        Binding("tab", "focus_next", "switch pane", show=True),
        Binding("c", "copy_id", "copy id"),
    ]

    def __init__(self, interval=2.0):
        super().__init__(ansi_color=True)
        self.interval = interval
        self.data = None
        self.rows = {}          # row key -> item
        self.selected = None
        self.report_for = None

    def compose(self) -> ComposeResult:
        yield Static("CR-0W · agents", id="title")
        yield Static(id="summary")
        with Horizontal(id="main"):
            yield DataTable(id="agents", cursor_type="row", zebra_stripes=False)
            with VerticalScroll(id="detail"):
                yield Static(id="detail-head")
                yield Static(id="timeline")
                yield Markdown(id="report")
        yield Footer()

    def on_mount(self):
        t = self.query_one("#agents", DataTable)
        t.border_title = "agents"
        self.query_one("#detail").border_title = "details"
        t.add_column("", key="st", width=2)
        t.add_column("project", key="project", width=16)
        t.add_column("active", key="age", width=6)
        t.add_column("ctx", key="ctx", width=5)
        t.add_column("commits", key="commits", width=7)
        t.add_column("task  ↳ doing now", key="task", width=40)
        self.set_interval(self.interval, self.action_refresh)
        self.action_refresh()

    def on_resize(self, event):
        self.set_class(event.size.width < 100, "narrow")
        self.call_after_refresh(self.fit_doing)

    def fit_doing(self):
        t = self.query_one("#agents", DataTable)
        fixed = 2 + 16 + 6 + 5 + 7 + 6 * 2 + 2  # column widths + cell padding + scrollbar
        col = t.columns.get("task")
        if col:
            col.width = max(20, t.size.width - fixed)
            t.refresh()

    # ---------- data ----------
    def action_refresh(self):
        self.load()

    @work(thread=True, exclusive=True)
    def load(self):
        data = runs.collect()
        self.call_from_thread(self.render_data, data)

    def action_copy_id(self):
        item = self.rows.get(self.selected)
        if item:
            ident = item.get("run_id") or item.get("session_id") or ""
            self.copy_to_clipboard(ident)
            self.notify(f"copied {ident[:8]}")

    # ---------- rendering ----------
    def render_data(self, data):
        self.data = data
        agents = data["agents"]
        bg = [a for a in agents if a["kind"] == "run"]
        sess = sorted((a for a in agents if a["kind"] == "session"), key=lambda a: a["last_activity_s"])
        fin = data["finished"][: runs.FINISHED_SHOWN]
        waiting = sum(1 for a in agents if a["state"] == "waiting")
        working = sum(1 for a in agents if a["state"] == "working")

        sl = data["slots"]
        slots = "▰" * sl["busy"] + "▱" * max(0, sl["max"] - sl["busy"])
        s = Text()
        s.append("Slots: ", style="bold magenta")
        s.append(f"{slots} {sl['busy']}/{sl['max']}")
        s.append(f"   ● {working} working", style="green")
        s.append(f"   ◆ {waiting} need you", style="bold magenta" if waiting else "bright_black")
        s.append(f"   ✓ {len(data['finished'])} finished today", style="bright_black")
        s.append(f"   {datetime.now():%H:%M:%S}", style="bright_black")
        self.query_one("#summary", Static).update(s)

        t = self.query_one("#agents", DataTable)
        keep = self.selected
        t.clear()
        self.rows = {}

        def section(key, title, n):
            t.add_row("", Text(f"{title} ({n})", style="bold"), "", "", "", "", key=key)

        def add_agent(a):
            glyph, style, _ = STATE[a["state"]]
            key = a.get("run_id") or a.get("session_id") or str(a["pid"])
            task = a.get("label") or ("session " + (a.get("session_id") or "")[:8] if a["kind"] == "session" else "(not dispatched by crow)")
            doing = "waiting for your reply" if a["state"] == "waiting" else (a.get("last_action") or "")
            self.rows[key] = {**a, "_type": "agent"}
            cell = Text(no_wrap=True, overflow="ellipsis")
            cell.append(task + "\n")
            cell.append("↳ " + doing.replace("\n", " "), style="magenta" if a["state"] == "waiting" else "cyan")
            t.add_row(Text(glyph, style=style), Text(a["project"], style="bold"),
                      Text(ago(a["last_activity_s"]), style=style if a["state"] in ("working", "waiting") else "bright_black"),
                      ctx_cell(a.get("context_tokens")),
                      Text(str(len(a.get("commits") or [])) if a["kind"] == "run" else "", style="cyan"),
                      cell, key=key, height=2)

        section("§runs", "RUNS", len(bg))
        for a in bg:
            add_agent(a)
        if not bg:
            t.add_row("", Text("none", style="bright_black"), "", "", "", "", key="§runs-none")
        section("§sess", "SESSIONS", len(sess))
        for a in sess:
            add_agent(a)
        if fin:
            section("§fin", "FINISHED", len(data["finished"]))
            for f in fin:
                glyph, style, _ = STATE[f["status"]]
                self.rows[f["run_id"]] = {**f, "_type": "finished"}
                ended = runs.iso_age(f["ended_at"]) if f.get("ended_at") else None
                cell = Text(no_wrap=True, overflow="ellipsis")
                cell.append(f["label"] + "\n")
                cell.append("↳ " + STATE[f["status"]][2] + (f" · resumed {len(f['resumed_from'])}×" if f.get("resumed_from") else ""), style=style)
                t.add_row(Text(glyph, style=style), Text(f["project"], style="default"),
                          Text(ago(ended), style="bright_black"), "", Text(str(len(f["commits"])), style="cyan"),
                          cell, key=f["run_id"], height=2)

        # keep the cursor where it was, else land on the first real row
        target = keep if keep in self.rows else next(iter(self.rows), None)
        if target:
            try:
                t.move_cursor(row=t.get_row_index(target))
            except Exception:
                pass
        self.show_detail(target)
        self.fit_doing()

    def on_data_table_row_highlighted(self, event):
        key = event.row_key.value if event.row_key else None
        if key and key.startswith("§"):
            return
        self.show_detail(key)

    def show_detail(self, key):
        self.selected = key
        head = self.query_one("#detail-head", Static)
        tl = self.query_one("#timeline", Static)
        rep = self.query_one("#report", Markdown)
        item = self.rows.get(key)
        if not item:
            head.update(Text("nothing selected", style="bright_black"))
            tl.update("")
            rep.update("")
            return

        h = Text()
        if item["_type"] == "agent":
            glyph, style, label = STATE[item["state"]]
            h.append(f"{glyph} {label}", style=style)
            h.append(f"   {item['project']}\n", style="bold")
            if item.get("label"):
                h.append(item["label"] + "\n", style="bold")
            h.append(f"{'run ' + item['run_id'][:8] if item.get('run_id') else 'session ' + (item.get('session_id') or '')[:8]}"
                     f" · {item['account']} · up {ago(runs.iso_age(item['started_at']))}"
                     f" · last activity {ago(item['last_activity_s'])} ago", style="bright_black")
            if item.get("subagents_active"):
                h.append(f" · {item['subagents_active']} subagents", style="cyan")
            h.append(f"\n{item['cwd']}", style="bright_black")
            head.update(h)

            body = Text(no_wrap=True, overflow="ellipsis")
            body.append("Recent activity\n", style="bold magenta")
            for ev in item.get("recent") or []:
                body.append(f"{ts_local(ev['ts'])}  ", style="bright_black")
                act = ev["action"]
                tool, _, rest = act.partition(": ")
                body.append(tool, style="magenta" if tool == "says" else "cyan")
                body.append(f"  {rest.splitlines()[0] if rest else ''}\n")
            if item.get("commits"):
                body.append("\nCommits\n", style="bold magenta")
                for c in item["commits"]:
                    sha, _, msg = c.partition(" ")
                    body.append(sha, style="yellow")
                    body.append(f" {msg}\n")
            tl.update(body)
            rep.update("")
            self.report_for = None
        else:
            glyph, style, label = STATE[item["status"]]
            h.append(f"{glyph} {label}", style=style)
            h.append(f"   {item['project']}\n", style="bold")
            h.append(item["label"] + "\n", style="bold")
            dur = ago(item["duration_s"]) if item.get("duration_s") else "?"
            h.append(f"run {item['run_id'][:8]} · ran {dur}", style="bright_black")
            if item.get("ended_at"):
                h.append(f" · ended {ago(runs.iso_age(item['ended_at']))} ago", style="bright_black")
            if item.get("resumed_from"):
                h.append(f" · resumed after {', '.join(r[:8] for r in item['resumed_from'])}", style="yellow")
            head.update(h)
            body = Text(no_wrap=True, overflow="ellipsis")
            if item.get("commits"):
                body.append("Commits\n", style="bold magenta")
                for c in item["commits"]:
                    sha, _, msg = c.partition(" ")
                    body.append(sha, style="yellow")
                    body.append(f" {msg}\n")
            tl.update(body)
            if self.report_for != item["run_id"]:
                self.report_for = item["run_id"]
                rep.update("*loading report…*")
                self.load_report(item["run_id"])

    @work(thread=True, exclusive=True, group="report")
    def load_report(self, run_id):
        text = runs.report(run_id) or "*no report*"
        self.call_from_thread(self._set_report, run_id, text)

    def _set_report(self, run_id, text):
        if self.report_for == run_id:
            self.query_one("#report", Markdown).update("## Report\n\n" + text)


if __name__ == "__main__":
    import argparse
    ap = argparse.ArgumentParser(prog="crow watch")
    ap.add_argument("--interval", type=float, default=2.0)
    CrowWatch(ap.parse_args().interval).run()

#!/usr/bin/env bash
# crow: launcher for the CR-0W hub, built on cdx.
#
#   crow                 open the hub session
#   crow brief           print the morning brief (one-shot run)
#   crow daily           draft today's daily into the state dir (one-shot run; post it from the hub)
#   crow weekly          build the weekly rollup + slide outline (one-shot run)
#   crow open <project> [prompt]  open a session in a registered project, optionally on a first message
#   crow term <project> [prompt]  same, in a new kitty window (safe to call from inside a Claude session)
#   crow ls              list registered projects
#   crow runs [--all]    background runs: status, task, commits so far
#   crow dispatch <project> <label> --prompt-file F   start a tracked background run
#   crow json            agents as JSON (for widgets); crow report <run_id> prints a run's final report
#   crow watch           live two-pane board of every agent (runs, sessions, finished)
#   crow activity [...]  raw activity (see crow-activity --help)
#   crow releases [...]  release tracks: roadmap progress toward public releases
set -euo pipefail

CROW_HOME="${CROW_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CROW_ACCOUNT="${CROW_ACCOUNT:-main}"
REGISTRY="$CROW_HOME/local/projects.yaml"
export CROW_HOME

project_path() {
  python3 - "$REGISTRY" "$1" <<'EOF'
import sys, yaml
reg = yaml.safe_load(open(sys.argv[1]))
for p in reg["projects"]:
    if p["name"] == sys.argv[2]:
        print(p["path"]); break
else:
    sys.exit(f"crow: unknown project '{sys.argv[2]}' (see: crow ls)")
EOF
}

oneshot() {
  local prompt="$1" out
  out=$(cdx run "$CROW_ACCOUNT" --cwd "$CROW_HOME" --prompt "$prompt" --permission auto --json)
  local ok stdout_path
  ok=$(jq -r '.ok' <<<"$out")
  stdout_path=$(jq -r '.stdout_path' <<<"$out")
  if [[ "$ok" != "true" ]]; then
    jq -r '.error // "run failed"' <<<"$out" >&2
    exit 1
  fi
  # cdx stores Claude's JSON result envelope; print only the Markdown result.
  local text
  text=$(jq -rs 'map(select(type == "object" and .type == "result")) | last | .result // empty' "$stdout_path" 2>/dev/null)
  [[ -z "$text" ]] && text=$(cat "$stdout_path")
  if [[ -t 1 ]] && command -v bat >/dev/null; then
    bat --language md --style plain --paging never <<<"$text"
  else
    printf '%s\n' "$text"
  fi
  jq -r '"\n— \(.usage.total_tokens) tokens · \(.duration_seconds|floor)s · run \(.run_id)"' <<<"$out" >&2
}

cmd="${1:-hub}"
shift || true
case "$cmd" in
  hub)      exec cdx "$CROW_ACCOUNT" --dir "$CROW_HOME" ;;
  brief)    oneshot "/brief" ;;
  daily)    oneshot "/daily Draft only: save the draft to the state dir as drafts/daily-$(date +%F).md and print it. Do not post anything." ;;
  weekly)   oneshot "/weekly" ;;
  open)     dir="$(project_path "${1:?usage: crow open <project> [prompt]}")"
            exec cdx "$CROW_ACCOUNT" --dir "$dir" ${2:+--prompt "$2"} ;;
  term)     # Detach from the calling session: real HOME (kitty config) and no inherited
            # Claude/cdx variables (session markers, ANTHROPIC_PROFILE, CDX_SESSION_NAME).
            dir="$(project_path "${1:?usage: crow term <project> [prompt]}")"
            strip=(); for v in $(compgen -e | grep -E '^(CLAUDE|CLAUDECODE|ANTHROPIC_|CDX_)'); do strip+=(-u "$v"); done
            env "${strip[@]}" HOME="$(getent passwd "$(id -un)" | cut -d: -f6)" \
              setsid -f kitty --title "crow · $1" "$CROW_HOME/bin/crow" open "$@" >/dev/null 2>&1 ;;
  ls)       python3 -c "
import yaml
for p in yaml.safe_load(open('$REGISTRY'))['projects']:
    print(f\"{p['name']:<30} {p['scope']:<9} {p['status']:<9} {p['path']}\")" ;;
  runs)     exec "$CROW_HOME/bin/crow-runs" list "$@" ;;
  dispatch) exec "$CROW_HOME/bin/crow-runs" dispatch "$@" ;;
  json)     exec "$CROW_HOME/bin/crow-runs" json "$@" ;;
  report)   exec "$CROW_HOME/bin/crow-runs" report "$@" ;;
  watch)    # rebuild the Go board when its source is newer than the binary
            src="$CROW_HOME/tools/crow-watch"; bin="$src/crow-watch"
            if [[ ! -x "$bin" || -n "$(find "$src" -name '*.go' -newer "$bin" -o -name go.mod -newer "$bin")" ]]; then
              (cd "$src" && go build -o crow-watch .) || exit 1
            fi
            exec "$bin" "$@" ;;
  activity) exec "$CROW_HOME/bin/crow-activity" "$@" ;;
  releases) exec "$CROW_HOME/bin/crow-releases" "$@" ;;
  -h|--help|help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)        echo "crow: unknown command '$cmd' (crow help)" >&2; exit 1 ;;
esac

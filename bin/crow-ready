#!/usr/bin/env python3
"""crow-ready: Logics backlog items with status Ready, across the active registered projects.

  crow-ready json [--limit N]   {"schema", "total", "items": [{project, ref, title, path, progress, modified}]}

Newest first (file mtime), at most --limit items (default 8); `total` counts them all.
Reads each repo through `logics-manager flow list --kind backlog --format json`.
A repo without logics/backlog, or whose listing fails, is skipped and named in "skipped".
"""
import argparse
import json
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import crow_lib  # noqa: E402


def listing(root):
    """Backlog entries of one repo (raises on a failed or unreadable listing)."""
    r = subprocess.run(["logics-manager", "--repo-root", root, "flow", "list", "--kind", "backlog", "--format", "json"],
                       capture_output=True, text=True, timeout=20)
    if r.returncode:
        raise RuntimeError((r.stderr or r.stdout).strip()[:160] or f"exit {r.returncode}")
    return json.loads(r.stdout).get("entries") or []


def ready(projects, lister=listing):
    items, skipped = [], {}
    repos = [p for p in projects if p.get("status", "active") == "active" and p.get("path")
             and os.path.isdir(os.path.join(p["path"], "logics", "backlog"))]

    def one(p):
        try:
            return p, lister(p["path"]), None
        except Exception as e:  # noqa: BLE001 - one broken repo must not hide the others
            return p, [], str(e)
    with ThreadPoolExecutor(max_workers=6) as pool:
        done = list(pool.map(one, repos))
    for p, entries, err in done:
        root = p["path"]
        if err:
            skipped[p["name"]] = err
        for e in entries:
            if e.get("status") != "Ready":
                continue
            path = os.path.join(root, e.get("path", ""))
            try:
                mtime = os.path.getmtime(path)
            except OSError:
                mtime = 0
            items.append({"project": p["name"], "ref": e.get("ref", ""), "title": e.get("title") or e.get("ref", ""),
                          "path": path, "progress": e.get("progress") or "",
                          "modified": datetime.fromtimestamp(mtime, timezone.utc).isoformat(timespec="seconds")})
    items.sort(key=lambda i: i["modified"], reverse=True)
    return items, skipped


def main():
    ap = argparse.ArgumentParser(prog="crow-ready")
    sub = ap.add_subparsers(dest="cmd", required=True)
    j = sub.add_parser("json")
    j.add_argument("--limit", type=int, default=8)
    a = ap.parse_args()
    items, skipped = ready(crow_lib.registry().get("projects") or [])
    out = {"schema": 1, "total": len(items), "items": items[:max(a.limit, 0)]}
    if skipped:
        out["skipped"] = skipped
    print(json.dumps(out))


if __name__ == "__main__":
    main()

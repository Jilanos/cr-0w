#!/usr/bin/env python3
"""Render a pending-items Markdown file as a self-contained HTML dashboard.

The Markdown stays the source of truth (humans and agents edit it). This script only
renders it: one collapsible block per heading, one card per table row, status filters
from the legend emojis, ages computed from the date column, links made clickable
(Markdown links, URLs, `backticked/paths`), long cells folded with the full text on hover.

usage: crow-board <file.md> [-o out.html] [--root-map LOCAL=URL ...] [--today DD/MM/YYYY]

--root-map rewrites local path prefixes into links, e.g.
  --root-map "WORK/=file://wsl.localhost/Ubuntu/home/me/dev/WORK/"
Relative paths in a table are resolved against the nearest "Dossier : `path`" line above it.
"""
import argparse
import datetime as dt
import html
import re
import sys
from pathlib import Path
from urllib.parse import quote

STATUS = {"🟢": ("go", "Go attendu"), "🟡": ("review", "Relecture"), "🔵": ("action", "Action"),
          "⏸️": ("paused", "En pause"), "🔴": ("urgent", "Urgent"), "🟠": ("soon", "Bientôt")}
DATE_RE = re.compile(r"\b(\d{2})/(\d{2})(?:/(\d{4}))?\b")
MDLINK_RE = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")
URL_RE = re.compile(r"(?<![\"'=(])\bhttps?://[^\s<>|)]+")
CODE_RE = re.compile(r"`([^`]+)`")
BOLD_RE = re.compile(r"\*\*([^*]+)\*\*")
FOLD_AT = 180


def parse_date(text, today):
    m = DATE_RE.search(text or "")
    if not m:
        return None
    d, mo, y = int(m.group(1)), int(m.group(2)), m.group(3)
    year = int(y) if y else today.year
    try:
        date = dt.date(year, mo, d)
    except ValueError:
        return None
    if not y and date > today + dt.timedelta(days=60):
        date = date.replace(year=year - 1)
    return date


def workdays_between(a, b):
    if a >= b:
        return 0
    days, cur = 0, a
    while cur < b:
        cur += dt.timedelta(days=1)
        if cur.weekday() < 5:
            days += 1
    return days


class Linker:
    def __init__(self, root_map):
        self.root_map = root_map
        self.base = None

    def path_url(self, p):
        for local, url in self.root_map:
            if p.startswith(local):
                return url + quote(p[len(local):])
        if self.base and "/" not in p.strip("/") and "." in p and " " not in p.strip():
            return self.path_url(self.base.rstrip("/") + "/" + p)
        if self.base and not p.startswith(("/", "http")) and "/" in p:
            cand = self.base.rstrip("/") + "/" + p
            for local, url in self.root_map:
                if cand.startswith(local):
                    return url + quote(cand[len(local):])
        return None

    def inline(self, text):
        """Markdown inline → HTML. Escapes first, then re-inserts links via placeholders."""
        slots = []

        def keep(s):
            slots.append(s)
            return f"\x00{len(slots) - 1}\x00"

        def mdlink(m):
            return keep(f'<a href="{html.escape(m.group(2), quote=True)}" target="_blank" rel="noopener">'
                        f'{html.escape(m.group(1))}</a>')

        def code(m):
            p = m.group(1)
            url = self.path_url(p)
            inner = f"<code>{html.escape(p)}</code>"
            if url:
                return keep(f'<a class="path" href="{html.escape(url, quote=True)}" title="Ouvrir {html.escape(p, quote=True)}">{inner}</a>')
            return keep(inner)

        def url(m):
            u = m.group(0)
            return keep(f'<a href="{html.escape(u, quote=True)}" target="_blank" rel="noopener">lien</a>')

        text = MDLINK_RE.sub(mdlink, text)
        text = CODE_RE.sub(code, text)
        text = URL_RE.sub(url, text)
        text = html.escape(text)
        text = BOLD_RE.sub(r"<b>\1</b>", text)
        return re.sub(r"\x00(\d+)\x00", lambda m: slots[int(m.group(1))], text)


def plain(text):
    text = MDLINK_RE.sub(r"\1", text)
    return CODE_RE.sub(r"\1", text).replace("**", "")


def status_of(text):
    for emo, (key, _) in STATUS.items():
        if emo in text:
            return key
    return ""


def split_row(line):
    cells = re.split(r"(?<!\\)\|", line.strip().strip("|"))
    return [c.strip() for c in cells]


def parse(md):
    """Return (title, intro_lines, sections). Section = dict(level, title, blocks)."""
    title, intro, sections, cur = "", [], [], None
    lines = md.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.startswith("# ") and not title:
            title = line[2:].strip()
        elif line.startswith("## ") or line.startswith("### "):
            level = 2 if line.startswith("## ") else 3
            cur = {"level": level, "title": line.lstrip("#").strip(), "blocks": []}
            sections.append(cur)
        elif line.strip().startswith("|") and i + 1 < len(lines) and re.match(r"^\s*\|[\s:|-]+\|\s*$", lines[i + 1]):
            header = split_row(line)
            rows = []
            i += 2
            while i < len(lines) and lines[i].strip().startswith("|"):
                rows.append(split_row(lines[i]))
                i += 1
            (cur["blocks"] if cur else intro).append(("table", header, rows))
            continue
        elif line.strip().startswith("- "):
            items = []
            while i < len(lines) and lines[i].strip().startswith("- "):
                items.append(lines[i].strip()[2:])
                i += 1
            (cur["blocks"] if cur else intro).append(("list", items))
            continue
        elif line.strip():
            (cur["blocks"] if cur else intro).append(("para", line.strip()))
        i += 1
    return title, intro, sections


def render_cell(text, linker, cls=""):
    inner = linker.inline(text)
    full = html.escape(plain(text), quote=True)
    if len(plain(text)) > FOLD_AT:
        short = linker.inline(plain(text)[:FOLD_AT].rsplit(" ", 1)[0] + " …")
        return (f'<div class="cell fold {cls}" data-tip="{full}"><span class="short">{short}</span>'
                f'<span class="long">{inner}</span><button class="more" type="button">plus</button></div>')
    return f'<div class="cell {cls}" data-tip="{full}">{inner}</div>'


def render_table(header, rows, linker, today):
    hl = [h.lower() for h in header]
    date_col = next((k for k, h in enumerate(hl) if h in ("depuis", "échéance", "date", "reçu")), None)
    out = []
    for r in rows:
        r = r + [""] * (len(header) - len(r))
        rowtext = " ".join(r)
        st = status_of(rowtext)
        age_html, age_cls, age_days = "", "", ""
        if date_col is not None:
            d = parse_date(r[date_col], today)
            if d:
                if hl[date_col] == "échéance":
                    delta = (d - today).days
                    age_cls = "late" if delta < 0 or "dépassée" in r[date_col] else ("due" if delta <= 1 else "")
                    age_html = f'<span class="age {age_cls}" title="Échéance {d:%d/%m/%Y}">' + (
                        f"J{delta:+d}" if delta else "aujourd'hui") + "</span>"
                    age_days = str(-delta)
                else:
                    wd = workdays_between(d, today)
                    age_cls = "late" if wd > 5 else ("due" if wd >= 3 else "")
                    age_html = (f'<span class="age {age_cls}" title="Depuis le {d:%d/%m/%Y}, {wd} jour(s) ouvré(s)">'
                                f"{wd} j</span>")
                    age_days = str(wd)
        cells, tags = [], []
        for k, (h, c) in enumerate(zip(header, r)):
            if k == date_col:
                continue
            if hl[k] not in ("sujet", "attendu") and len(plain(c)) <= 32:
                tags.append(f'<span class="tag" title="{html.escape(h, quote=True)}">{linker.inline(c)}</span>')
                continue
            cells.append(f'<div class="field"><div class="label">{html.escape(h)}</div>{render_cell(c, linker)}</div>')
        date_txt = html.escape(r[date_col]) if date_col is not None else ""
        out.append(f'<article class="card st-{st or "none"} {age_cls}" data-status="{st}" data-age="{age_days}" '
                   f'data-text="{html.escape(plain(rowtext).lower(), quote=True)}">'
                   f'<div class="meta">{age_html}<span class="date">{date_txt}</span>{"".join(tags)}</div>{"".join(cells)}</article>')
    return f'<div class="cards">{"".join(out)}</div>'


def render_blocks(blocks, linker, today):
    out = []
    for b in blocks:
        if b[0] == "table":
            out.append(render_table(b[1], b[2], linker, today))
        elif b[0] == "list":
            items = "".join(
                f'<li class="item st-{status_of(it) or "none"}" data-status="{status_of(it)}" '
                f'data-text="{html.escape(plain(it).lower(), quote=True)}">{linker.inline(it)}</li>' for it in b[1])
            out.append(f"<ul class=\"items\">{items}</ul>")
        else:
            m = re.match(r"^Dossier\s*:\s*`([^`]+)`", b[1])
            if m:
                linker.base = m.group(1)
            out.append(f'<p class="para">{linker.inline(b[1])}</p>')
    return "".join(out)


CSS = """

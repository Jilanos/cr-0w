"""

JS = """
const q=document.querySelector('#q'),chips=[...document.querySelectorAll('.chip[data-f]')];
let active=new Set();
function apply(){const t=q.value.trim().toLowerCase();
document.querySelectorAll('.card,.item').forEach(el=>{const okS=!active.size||active.has(el.dataset.status)||
(active.has('late')&&el.classList.contains('late'));const okT=!t||el.dataset.text.includes(t);
el.classList.toggle('hidden',!(okS&&okT))});
document.querySelectorAll('details').forEach(d=>{const n=d.querySelectorAll('.card:not(.hidden),.item:not(.hidden)').length;
const c=d.querySelector(':scope>summary .count');if(c)c.textContent=n;d.classList.toggle('hidden',(active.size||t)&&!n);
if(active.size||t){if(n)d.open=true}});
try{localStorage.setItem('board-f',JSON.stringify([...active]))}catch(e){}}
chips.forEach(c=>c.addEventListener('click',()=>{const f=c.dataset.f;active.has(f)?active.delete(f):active.add(f);
c.setAttribute('aria-pressed',active.has(f));apply()}));q.addEventListener('input',apply);
document.querySelectorAll('.more').forEach(b=>b.addEventListener('click',e=>{const c=b.closest('.cell');
c.classList.toggle('open');b.textContent=c.classList.contains('open')?'moins':'plus'}));
document.querySelector('#all').addEventListener('click',()=>{const o=![...document.querySelectorAll('details')].every(d=>d.open);
document.querySelectorAll('details').forEach(d=>d.open=o)});
document.querySelector('.theme').addEventListener('click',()=>{const r=document.documentElement;
const n=r.dataset.theme==='dark'?'light':'dark';r.dataset.theme=n;try{localStorage.setItem('board-theme',n)}catch(e){}});
try{const th=localStorage.getItem('board-theme');if(th)document.documentElement.dataset.theme=th;
JSON.parse(localStorage.getItem('board-f')||'[]').forEach(f=>{const c=chips.find(x=>x.dataset.f===f);
if(c){active.add(f);c.setAttribute('aria-pressed','true')}})}catch(e){}
apply();
const ttl=parseInt(document.body.dataset.refresh||'0',10);if(ttl)setTimeout(()=>location.reload(),ttl*1000);
"""


def build(md, root_map, today, source_name, refresh):
    title, intro, sections = parse(md)
    linker = Linker(root_map)
    counts = {}
    for st in STATUS.values():
        counts[st[0]] = 0
    for emo, (key, _) in STATUS.items():
        counts[key] = len(re.findall(r"^\|.*" + re.escape(emo), md, re.M)) + len(re.findall(r"^\s*- .*" + re.escape(emo), md, re.M))
    body, open_l2 = [], False
    for s in sections:
        inner = render_blocks(s["blocks"], linker, today)
        tl = linker.inline(s["title"])
        closed = "⏸️" in s["title"] or "Réglé" in s["title"]
        if s["level"] == 2:
            if open_l2:
                body.append("</div></details>")
            body.append(f'<details class="l2"{"" if closed else " open"}><summary>{tl}<span class="count"></span></summary><div class="body">{inner}')
            open_l2 = True
        else:
            body.append(f'<details class="l3" open><summary>{tl}<span class="count"></span></summary><div class="body">{inner}</div></details>')
    if open_l2:
        body.append("</div></details>")
    intro_html = render_blocks(intro, linker, today)
    chips = "".join(f'<button class="chip" type="button" data-f="{k}" aria-pressed="false">{e} {lbl}<b>{counts[k]}</b></button>'
                    for e, (k, lbl) in STATUS.items() if counts[k])
    chips += '<button class="chip" type="button" data-f="late" aria-pressed="false">⏰ En retard</button>'
    gen = dt.datetime.now().strftime("%d/%m/%Y %H:%M")
    return f"""<!doctype html><html lang="fr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>{html.escape(title or 'Tableau de bord')}</title>
<style>{CSS}</style></head><body data-refresh="{refresh}">
<header><h1>{html.escape(title or 'Tableau de bord')}</h1>
<div class="sub">Généré le {gen} depuis {html.escape(source_name)} · âge en jours ouvrés · survol = texte complet</div>
<div class="bar">{chips}<input id="q" type="search" placeholder="Filtrer (fournisseur, sujet…)">
<button class="chip" id="all" type="button">Tout ouvrir / fermer</button><button class="chip theme" type="button">◐</button></div>
</header><main>{intro_html}{''.join(body)}</main><script>{JS}</script></body></html>"""


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("md")
    ap.add_argument("-o", "--out")
    ap.add_argument("--root-map", action="append", default=[], help="LOCAL_PREFIX=URL_PREFIX")
    ap.add_argument("--today", help="DD/MM/YYYY (tests)")
    ap.add_argument("--refresh", type=int, default=300, help="auto-reload seconds, 0 = off")
    a = ap.parse_args()
    today = dt.datetime.strptime(a.today, "%d/%m/%Y").date() if a.today else dt.date.today()
    root_map = []
    for rm in a.root_map:
        local, _, url = rm.partition("=")
        root_map.append((local, url))
    root_map.sort(key=lambda x: -len(x[0]))
    src = Path(a.md)
    out = Path(a.out) if a.out else src.with_suffix(".html")
    out.write_text(build(src.read_text(encoding="utf-8"), root_map, today, src.name, a.refresh), encoding="utf-8")
    print(out)


if __name__ == "__main__":
    sys.exit(main())

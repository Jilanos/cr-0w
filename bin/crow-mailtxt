#!/usr/bin/env python3
"""Plain text of a mail read with the M365 connector, without the quoted history.

usage: crow-mailtxt <file> [--full] [--max N]
<file> is a saved read_resource result (JSON, possibly prefixed by a header line) or raw HTML.
Prints subject, from, to, cc, date and attachments, then the body cut at the first
reply/forward separator (Outlook divRplyFwdMsg, <hr>, "De :"/"From:" header block).
"""
import html
import json
import re
import sys


def to_text(h):
    h = re.sub(r"(?is)<(script|style|head)[^>]*>.*?</\1>", "", h)
    h = re.sub(r"(?i)<br\s*/?>", "\n", h)
    h = re.sub(r"(?i)</(div|p|tr|li|h\d)>", "\n", h)
    h = re.sub(r"(?s)<[^>]+>", "", h)
    t = html.unescape(h).replace("\xa0", " ")
    t = re.sub(r"[ \t]+", " ", t)
    return re.sub(r"\n\s*\n+", "\n\n", t).strip()


def cut(h):
    for pat in (r'(?i)<div id="appendonsend"', r'(?i)<div[^>]+id="divRplyFwdMsg"', r"(?i)<hr[^>]*>",
                r"(?im)^\s*(De|From)\s*:.*\n.*(Envoy|Sent)"):
        m = re.search(pat, h)
        if m:
            return h[:m.start()]
    return h


def load(path):
    raw = open(path, encoding="utf-8", errors="replace").read()
    start = raw.find("{")
    if start != -1:
        try:
            return json.loads(raw[start:raw.rfind("}") + 1])
        except json.JSONDecodeError:
            pass
    return {"body": {"content": raw}}


def addr(lst):
    return ", ".join(f"{r.get('name', '')} <{r.get('address', '')}>" for r in lst or [])


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    full = "--full" in argv
    mx = int(argv[argv.index("--max") + 1]) if "--max" in argv else 6000
    d = load(argv[0])
    s = d.get("sender") or {}
    print(f"Objet : {d.get('subject', '')}")
    if s:
        print(f"De : {s.get('name', '')} <{s.get('address', '')}>  ·  {d.get('receivedDateTime', '')}")
    if d.get("toRecipients"):
        print(f"À : {addr(d['toRecipients'])}")
    if d.get("ccRecipients"):
        print(f"Cc : {addr(d['ccRecipients'])}")
    atts = [a for a in d.get("attachments") or [] if not a.get("isInline")]
    for a in atts:
        print(f"PJ : {a.get('name')} ({a.get('size', 0) // 1024} Ko) {a.get('uri', '')}")
    if d.get("webLink"):
        print(f"Lien : {d['webLink']}")
    body = (d.get("body") or {}).get("content", "") or d.get("html", "")
    text = to_text(body if full else cut(body))
    print("\n" + text[:mx] + ("\n[…tronqué]" if len(text) > mx else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

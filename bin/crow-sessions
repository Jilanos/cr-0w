#!/usr/bin/env python3
"""crow-sessions: registry of sessions cut off by a usage limit, relaunchable on another account.

  crow-sessions scan [--json]     rescan every cdx profile, write the registry, print it
  crow-sessions list [--json]     same as scan (the cache makes a rescan cheap)
  crow-sessions show <id>         one entry as JSON (id or a unique prefix)
  crow-sessions mark-relaunched <id> <source> <target> <cwd>   record a handoff (crow-relaunch)

A session is interrupted when its last turn is a usage-limit error: a Claude transcript's
last user/assistant event, or a Codex rollout's last limit error after its last prompt.
Every entry carries its provider, account and native conversation id; profiles come from
`cdx configs` (or CDX_PROFILES). Retros and automatic jobs crow starts (/retro, /brief,
/daily, /weekly, session titles, on either provider) are left out.
Each transcript is read once per (mtime, size): unchanged files come from the cache.
A session that ran in more than one workspace is flagged: cdx refuses to hand those off.

Files, in the state dir (vault.crow_dir, else local/state):
  interrupted-sessions.json   the registry
  sessions-cache.json         per-transcript scan results
  relaunches.jsonl            written by crow-relaunch; entries listed there show as relaunched
"""
import json, os, pwd, sys
from datetime import datetime, timezone

import yaml

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import crow_cdx  # noqa: E402
import crow_native  # noqa: E402

HOME = os.environ.get("CROW_HOME") or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
REAL_HOME = pwd.getpwuid(os.getuid()).pw_dir
PROFILES = os.environ.get("CDX_PROFILES", os.path.join(REAL_HOME, ".cdx", "profiles"))
AUTO_PREFIXES = ("/retro ", "/retro\n", "/brief", "/daily", "/weekly")
TAIL_BYTES = 256_000
CACHE_VERSION = 3  # 3: provider-qualified entries and Codex rollouts


def registry():
    try:
        return yaml.safe_load(open(os.path.join(HOME, "local", "projects.yaml"))) or {}
    except FileNotFoundError:
        return {}


def state_dir():
    return (registry().get("vault") or {}).get("crow_dir") or os.path.join(HOME, "local", "state")


def project_of(cwd, projects):
    """Registered project whose path holds cwd (deepest wins), else the folder name."""
    best = None
    for p in projects:
        root = os.path.realpath(os.path.expanduser(p.get("path") or ""))
        if root and (cwd == root or cwd.startswith(root + os.sep)) and (not best or len(root) > len(best[1])):
            best = (p["name"], root)
    return best[0] if best else os.path.basename(cwd.rstrip("/"))


def transcripts():
    """(account, provider, path) for every top-level conversation file in every profile."""
    try:
        profs = crow_cdx.profiles()
    except crow_cdx.CdxError as e:
        print(f"crow-sessions: {e.message}", file=sys.stderr)
        return
    for prof in profs:
        if prof["provider"] == "codex":
            for path in sorted(crow_native.codex_rollouts(prof["root"])):
                yield prof["name"], "codex", path
            continue
        base = crow_cdx.claude_projects_dir(prof["root"])
        if prof["provider"] != "claude" or not os.path.isdir(base):
            continue
        for slug in sorted(os.listdir(base)):
            d = os.path.join(base, slug)
            if not os.path.isdir(d):
                continue
            for f in sorted(os.listdir(d)):
                if f.endswith(".jsonl"):
                    yield prof["name"], "claude", os.path.join(d, f)


def events(lines):
    for raw in lines:
        try:
            ev = json.loads(raw)
        except (json.JSONDecodeError, ValueError):
            continue
        if isinstance(ev, dict):
            yield ev


def text_of(ev):
    content = (ev.get("message") or {}).get("content")
    if isinstance(content, list):
        content = next((c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text"), "")
    return content if isinstance(content, str) else ""


def is_limit(ev):
    return bool(ev.get("isApiErrorMessage")) and (
        ev.get("apiError") == "usage_limit_reached" or ev.get("error") == "rate_limit")


def last_turn(path, size):
    with open(path, "rb") as fh:
        if size > TAIL_BYTES:
            fh.seek(size - TAIL_BYTES)
            fh.readline()  # drop the partial line
        lines = fh.read().decode("utf-8", "replace").splitlines()
    last, last_prompt = None, None
    for ev in events(lines):
        if ev.get("type") in ("user", "assistant"):
            last = ev
        elif ev.get("type") == "last-prompt":
            last_prompt = ev.get("lastPrompt")
    return last, last_prompt


def first_prompt(path):
    """The first message the user typed, or None for a session opened by /clear with no prompt."""
    with open(path, encoding="utf-8", errors="replace") as fh:
        for ev in events(fh):
            if ev.get("type") != "user" or ev.get("isMeta"):
                continue
            t = text_of(ev).strip()
            if not t or t.startswith(("<system-reminder>", "<local-command", "Caveat:", "[Request interrupted")):
                continue
            if "<command-name>" in t:
                if "<command-name>/clear</command-name>" in t:
                    continue
                return t.split("<command-name>", 1)[1].split("</command-name>", 1)[0] + \
                    (" " + t.split("<command-args>", 1)[1].split("</command-args>", 1)[0]
                     if "<command-args>" in t else "")
            return t
    return None


def workspaces(path):
    """Every workspace (cwd) the main conversation ran in; cdx hands off only when there is one."""
    cwds = set()
    with open(path, encoding="utf-8", errors="replace") as fh:
        for ev in events(fh):
            if not ev.get("isSidechain") and isinstance(ev.get("cwd"), str):
                cwds.add(os.path.realpath(ev["cwd"]))
    return sorted(cwds)


def scan_codex(acct, path, size):
    st = crow_native.read_codex(path)
    if not st or not st["limit_error"] or not st["native_id"]:
        return None
    if crow_native.AUTO_PROMPT.search(st["first_prompt"] or ""):
        return None
    cwd = os.path.realpath(st["cwd"]) if st["cwd"] else ""
    return {
        "conversation_id": st["native_id"], "provider": "codex", "account": acct, "cwd": cwd, "branch": None,
        "last_event": st["limit_error"]["ts"] or st["last_ts"], "limit": None, "resets_at": None,
        "message": st["limit_error"]["message"], "first_prompt": st["first_prompt"],
        "last_prompt": st["last_prompt"], "transcript": path, "size": size,
        "workspaces": [cwd] if cwd else [],
    }


def scan_one(acct, path, size, provider="claude"):
    if provider == "codex":
        return scan_codex(acct, path, size)
    last, last_prompt = last_turn(path, size)
    if not last or not is_limit(last):
        return None
    first = first_prompt(path)
    if first and (first.lstrip().startswith(AUTO_PREFIXES) or crow_native.AUTO_PROMPT.search(first)):
        return None
    limit = last.get("quotaLimits") or (last.get("apiErrorParams") or {}).get("rate_limit_info") or {}
    cwd = last.get("cwd") or ""
    return {
        "conversation_id": last.get("sessionId") or os.path.basename(path)[:-6],
        "provider": "claude",
        "account": acct,
        "cwd": cwd,
        "branch": last.get("gitBranch"),
        "last_event": last.get("timestamp"),
        "limit": limit.get("rateLimitType"),
        "resets_at": limit.get("resetsAt"),
        "message": text_of(last)[:200],
        "first_prompt": (first or "")[:400] or None,
        "last_prompt": (last_prompt or "")[:400] or None,
        "transcript": path,
        "size": size,
        "workspaces": workspaces(path),
    }


def load_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def relaunched(state):
    """Successful relaunches by source identity (provider:account:id), and by bare id for
    records written before providers were tracked. A prepared or failed launch is not one."""
    out = {}
    try:
        with open(os.path.join(state, "relaunches.jsonl")) as fh:
            for ev in events(fh):
                if not ev.get("conversation_id") or ev.get("status", "launched") != "launched":
                    continue
                if ev.get("source_provider"):
                    out[f"{ev['source_provider']}:{ev.get('source')}:{ev['conversation_id']}"] = ev
                else:
                    out[ev["conversation_id"]] = ev
    except FileNotFoundError:
        pass
    return out


def scan():
    state = state_dir()
    os.makedirs(state, exist_ok=True)
    cache_path = os.path.join(state, "sessions-cache.json")
    cache = load_json(cache_path, {})
    if cache.get("version") != CACHE_VERSION:
        cache = {"version": CACHE_VERSION, "files": {}}
    old, new, read = cache["files"], {}, 0
    for acct, provider, path in transcripts():
        try:
            st = os.stat(path)
        except FileNotFoundError:
            continue
        key = [int(st.st_mtime_ns), st.st_size]
        hit = old.get(path)
        if hit and hit["key"] == key:
            new[path] = hit
            continue
        read += 1
        new[path] = {"key": key, "entry": scan_one(acct, path, st.st_size, provider)}
    cache["files"] = new
    write_json(cache_path, cache)

    done = relaunched(state)
    projects = registry().get("projects") or []
    sessions = sorted((dict(v["entry"]) for v in new.values() if v["entry"]),
                      key=lambda e: e.get("last_event") or "")
    for s in sessions:
        s["project"] = project_of(s["cwd"], projects)
        s["identity"] = f"{s['provider']}:{s['account']}:{s['conversation_id']}"
        r = done.get(s["identity"]) or done.get(s["conversation_id"])
        s["relaunched"] = {"target": r.get("target"), "target_provider": r.get("target_provider"),
                           "mode": r.get("mode"), "at": r.get("at")} if r else None
    reg = {"generated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
           "transcripts": len(new), "read": read, "sessions": sessions}
    write_json(os.path.join(state, "interrupted-sessions.json"), reg)
    return reg


def write_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=1)
    os.replace(tmp, path)


def human_size(n):
    return f"{n / 1_000_000:.1f} MB" if n >= 1_000_000 else f"{n // 1000} KB"


def one_line(s, width):
    s = " ".join((s or "").split())
    return s if len(s) <= width else s[:width - 1] + "…"


def print_list(reg):
    rows = [s for s in reg["sessions"] if not s["relaunched"]]
    done = len(reg["sessions"]) - len(rows)
    print(f"{len(rows)} interrupted session(s)" + (f", {done} already relaunched" if done else "")
          + f"  ({reg['transcripts']} transcripts, {reg['read']} read)")
    for s in rows:
        when = (s["last_event"] or "")[:16].replace("T", " ")
        print(f"{when}  {s.get('provider', 'claude'):<6} {s['account']:<8} {one_line(s['project'], 22):<22} {s['conversation_id']}  "
              f"{human_size(s['size']):>8}  {one_line(s['first_prompt'] or '(no opening prompt)', 60)}"
              + ("" if len(s["workspaces"]) == 1 else f"  [{len(s['workspaces'])} workspaces: cdx cannot hand off]"))


def mark_relaunched(cid, source, target, cwd, **extra):
    """Append a relaunch record. extra: source_provider, target_provider, mode, status, ..."""
    crow_cdx.append_jsonl(os.path.join(state_dir(), "relaunches.jsonl"),
                          {"conversation_id": cid, "source": source, "target": target, "cwd": cwd,
                           "at": datetime.now(timezone.utc).isoformat(timespec="seconds"), **extra})


def find(reg, ref):
    hits = [s for s in reg["sessions"] if s["conversation_id"].startswith(ref)]
    if len(hits) != 1:
        sys.exit(f"crow-sessions: {len(hits)} sessions match '{ref}'")
    return hits[0]


def main(argv):
    cmd = argv[0] if argv else "list"
    if cmd in ("scan", "list"):
        reg = scan()
        if "--json" in argv:
            print(json.dumps(reg, indent=1))
        else:
            print_list(reg)
    elif cmd == "show" and len(argv) == 2:
        print(json.dumps(find(scan(), argv[1]), indent=1))
    elif cmd == "mark-relaunched" and len(argv) == 5:
        mark_relaunched(*argv[1:])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])

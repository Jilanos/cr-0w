{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crow/core/ops.schema.json",
  "title": "ops",
  "description": "Data of GET /api/state/ops?day=YYYY-MM-DD or ?week=YYYY-Www (item_257): the day lanes of every session and run, the queue, and totals per project and per kind. Totals are the sums of the lanes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["days", "lanes", "queue", "totals"],
  "properties": {
    "day": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "week": {"type": "string", "pattern": "^\\d{4}-W\\d{2}$"},
    "days": {"type": "array", "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
    "lanes": {"type": "array", "items": {"$ref": "#/$defs/lane"}},
    "queue": {"type": "array", "items": {"$ref": "#/$defs/queued"}},
    "totals": {"type": "array", "items": {"$ref": "#/$defs/total"}}
  },
  "$defs": {
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "day", "project", "account", "kind", "title", "state", "spans", "keys", "active_s", "wait_s", "cost_usd", "tokens", "commits", "runs"],
      "properties": {
        "id": {"type": "string", "description": "Session id, or the run id of the live run."},
        "day": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "project": {"type": "string", "description": "Registry short name when matched."},
        "account": {"type": "string"},
        "kind": {"enum": ["interactive", "run", "mission", "routine"]},
        "title": {"type": "string"},
        "model": {"type": "string"},
        "state": {"enum": ["needs", "working", "idle", "run", "paused", "done", "stuck", "failed"], "description": "State at the end of the day, or now for today."},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "keys": {"type": "array", "items": {"type": "string"}, "description": "Session and run ids folded into the lane."},
        "active_s": {"type": "integer", "minimum": 0, "description": "Seconds in working, stuck, failed and done spans."},
        "wait_s": {"type": "integer", "minimum": 0, "description": "Seconds in waiting spans."},
        "cost_usd": {"type": "number", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "commits": {"type": "integer", "minimum": 0},
        "runs": {"type": "integer", "minimum": 0}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "start", "end"],
      "properties": {
        "state": {"enum": ["working", "waiting", "idle", "stuck", "failed", "done"]},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "queued": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "title"],
      "properties": {
        "kind": {"enum": ["mission", "routine", "afk"]},
        "id": {"type": "string", "description": "Mission id, timer unit or AFK job file name."},
        "project": {"type": "string"},
        "title": {"type": "string"},
        "next": {"type": "string", "format": "date-time", "description": "Routines: next start."}
      }
    },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "name", "lanes", "active_s", "wait_s", "stuck", "failed", "cost_usd", "tokens"],
      "properties": {
        "by": {"enum": ["project", "kind"]},
        "name": {"type": "string"},
        "lanes": {"type": "integer", "minimum": 0},
        "active_s": {"type": "integer", "minimum": 0},
        "wait_s": {"type": "integer", "minimum": 0},
        "stuck": {"type": "integer", "minimum": 0, "description": "Lanes with a stuck span."},
        "failed": {"type": "integer", "minimum": 0, "description": "Lanes with a failed span."},
        "cost_usd": {"type": "number", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0}
      }
    }
  }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "crow/scripts/ready.schema.json",
 "title": "ready",
 "description": "crow-ready json: Logics backlog items with status Ready across the active registered projects, newest first.",
 "type": "object",
 "required": [
  "schema",
  "total",
  "items"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "project",
     "ref",
     "title",
     "path",
     "progress",
     "modified"
    ]
   }
  },
  "skipped": {
   "type": "object"
  }
 }
}
